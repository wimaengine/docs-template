---
import ApiReferenceSidebar from "./ApiReferenceSidebar.astro";

interface ApiSidebarItem {
  slug: string;
  name: string;
}

interface Props {
  groups: Array<[string, ApiSidebarItem[]]>;
  activeSlug?: string;
  blank?: boolean;
}

const { groups, activeSlug, blank = false } = Astro.props as Props;
---

<div class="api-shell">
  <div class:list={["api-main", blank ? "is-empty" : null]} aria-hidden={blank ? "true" : undefined}>
    <slot />
  </div>
  <ApiReferenceSidebar groups={groups} activeSlug={activeSlug} />
</div>

<style>
  .api-shell {
    width: calc(100% - 17.5rem + 2rem);
    height: calc(100vh - 4rem);
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: stable;
  }

  .api-main {
    min-width: 0;
    display: grid;
    gap: 1.75rem;
    width: min(100%, 70rem);
    margin-inline: auto;
  }

  .api-main.is-empty {
    min-height: 20rem;
  }

  @media (max-width: 1100px) {
    .api-shell {
      width: 100%;
      height: auto;
      overflow: visible;
    }

    .api-main {
      width: 100%;
    }
  }
</style>
