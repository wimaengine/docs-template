---
interface Props {
  blank?: boolean;
}

const { blank = false } = Astro.props as Props;
---

<div class="api-shell">
  <div class:list={["api-main", blank ? "is-empty" : null]} aria-hidden={blank ? "true" : undefined}>
    <slot />
  </div>
</div>

<style>
  .api-shell {
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .api-main {
    min-width: 0;
    display: grid;
    gap: 1.75rem;
    width: min(100%, 70rem);
    margin-inline: auto;
  }

  .api-main.is-empty {
    min-height: 20rem;
  }

  @media (max-width: 1100px) {
    .api-main {
      width: 100%;
    }
  }
</style>
