---
interface ApiCallableTypeParameter {
  name: string;
  constraint?: string;
  default?: string;
  description: string;
}

interface ApiCallableParameter {
  name: string;
  type: string;
  optional: boolean;
  rest: boolean;
  defaultValue: string;
  description: string;
}

interface ApiCallableReturn {
  type: string;
  description: string;
}

interface ApiCallable {
  signature: string;
  typeParameters: ApiCallableTypeParameter[];
  parameters: ApiCallableParameter[];
  returns?: ApiCallableReturn;
}

interface ApiSection {
  signature: string;
  callable?: ApiCallable;
}

interface Props {
  section: ApiSection;
  showSignature?: boolean;
}

const { section, showSignature = true } = Astro.props as Props;
const callable = section.callable ?? null;
const shouldRender = showSignature || Boolean(callable?.typeParameters.length || callable?.parameters.length || callable?.returns);

function splitParagraphs(value: string): string[] {
  return value
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

function formatTypeParameterLabel(typeParameter: ApiCallableTypeParameter): string {
  const parts = [`${typeParameter.name}`];

  if (typeParameter.constraint) {
    parts.push(`extends ${typeParameter.constraint}`);
  }

  if (typeParameter.default) {
    parts.push(`= ${typeParameter.default}`);
  }

  return parts.join(" ");
}

function formatParameterLabel(parameter: ApiCallableParameter): string {
  const qualifier = parameter.rest ? "Rest" : parameter.optional ? "Optional" : "";
  const segments = [];

  if (qualifier) {
    segments.push(qualifier);
  }

  segments.push(`${parameter.name}: ${parameter.type}`);

  if (parameter.defaultValue) {
    segments.push(`= ${parameter.defaultValue}`);
  }

  return segments.join(" ");
}
---

{shouldRender ? (
  <article class="api-callable">
    {showSignature ? (
      <p class="signature">
        <code>{section.signature}</code>
      </p>
    ) : null}

    {callable?.typeParameters.length ? (
      <section class="callable-meta">
        <h4>Type Parameters</h4>
        <div class="callable-list">
          {callable.typeParameters.map((typeParameter) => (
            <div class="callable-item">
              <p class="callable-item-name">
                <code>{formatTypeParameterLabel(typeParameter)}</code>
              </p>
              {typeParameter.description ? (
                <div class="callable-item-description">
                  {splitParagraphs(typeParameter.description).map((paragraph) => <p>{paragraph}</p>)}
                </div>
              ) : null}
            </div>
          ))}
        </div>
      </section>
    ) : null}

    {callable?.parameters.length ? (
      <section class="callable-meta">
        <h4>Parameters</h4>
        <div class="callable-list">
          {callable.parameters.map((parameter) => (
            <div class="callable-item">
              <p class="callable-item-name">
                {parameter.rest ? <span class="callable-flag">Rest</span> : parameter.optional ? <span class="callable-flag">Optional</span> : null}
                <code>{formatParameterLabel(parameter)}</code>
              </p>
              {parameter.description ? (
                <div class="callable-item-description">
                  {splitParagraphs(parameter.description).map((paragraph) => <p>{paragraph}</p>)}
                </div>
              ) : null}
            </div>
          ))}
        </div>
      </section>
    ) : null}

    {callable?.returns ? (
      <section class="callable-meta">
        <h4>Returns</h4>
        <div class="callable-list">
          <div class="callable-item">
            <p class="callable-item-name">
              <code>{callable.returns.type}</code>
            </p>
            {callable.returns.description ? (
              <div class="callable-item-description">
                {splitParagraphs(callable.returns.description).map((paragraph) => <p>{paragraph}</p>)}
              </div>
            ) : null}
          </div>
        </div>
      </section>
    ) : null}
  </article>
) : null}

<style>
  .api-callable {
    display: grid;
    gap: 0.9rem;
  }

  .signature {
    margin: 0;
    color: var(--accent-secondary);
    font-size: 0.92rem;
  }

  .signature code {
    display: inline-block;
    max-width: 100%;
    overflow-x: auto;
    padding: 0.2rem 0.35rem;
    background: var(--code-bg);
    color: var(--code-text);
  }

  .callable-meta {
    display: grid;
    gap: 0.45rem;
  }

  .callable-meta h4 {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .callable-list {
    display: grid;
    gap: 0.7rem;
  }

  .callable-item {
    display: grid;
    gap: 0.25rem;
  }

  .callable-item-name {
    margin: 0;
    color: var(--text);
    line-height: 1.55;
  }

  .callable-item-name code {
    display: inline-block;
    padding: 0.12rem 0.3rem;
    background: var(--code-bg);
    color: var(--code-text);
  }

  .callable-flag {
    display: inline-block;
    margin-right: 0.45rem;
    padding: 0.12rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .callable-item-description {
    display: grid;
    gap: 0.35rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .callable-item-description p {
    margin: 0;
  }
</style>
