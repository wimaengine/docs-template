---
import {
  formatDefaultValue,
  getParameterDescriptionMarkdown,
  getReflectionDescriptionMarkdown,
  getReflectionExamples,
  getReflectionSignatures,
  getReflectionTags,
  getReflectionThrowsMarkdown,
  getReturnDescriptionMarkdown,
  getTypeParameters
} from "../utils/typedoc.ts";
import ApiExamples from "./ApiExamples.astro";
import ApiMarkdown from "./ApiMarkdown.astro";
import ApiType from "./ApiType.astro";
import type { JSONOutput } from "typedoc";

interface Props {
  reflection: JSONOutput.DeclarationReflection;
  showDescription?: boolean;
  showTags?: boolean;
}

const {
  reflection,
  showDescription = true,
  showTags = true
} = Astro.props as Props;

const sourcePath = reflection?.sources?.[0]?.fileName;
const signatures = getReflectionSignatures(reflection);
const entries = (signatures.length > 0 ? signatures : [null]).map((signature) => ({
  signature,
  description: getReflectionDescriptionMarkdown(reflection, signature),
  examples: getReflectionExamples(reflection, signature),
  tags: getReflectionTags(reflection, signature),
  throws: getReflectionThrowsMarkdown(reflection, signature),
  typeParameters: getTypeParameters(signature ?? reflection),
  parameters: signature?.parameters ?? [],
  returnDescription: getReturnDescriptionMarkdown(reflection, signature)
}));
const defaultValue = formatDefaultValue(reflection.defaultValue);
const shouldRender = showDescription || showTags || Boolean(defaultValue) || entries.some((entry) => (
  entry.examples.length > 0 ||
  entry.throws.length > 0 ||
  entry.typeParameters.length > 0 ||
  entry.parameters.length > 0 ||
  Boolean(entry.returnDescription)
));
---

{shouldRender ? (
  <article class="api-reflection">
    {entries.map((entry) => (
      <div class="api-reflection-entry">
        {showDescription && entry.description ? (
          <ApiMarkdown content={entry.description} className="reflection-description" sourcePath={sourcePath} />
        ) : null}

        {entry.examples.length > 0 ? <ApiExamples reflection={reflection} signature={entry.signature} /> : null}

        {entry.typeParameters.length > 0 ? (
          <section class="reflection-meta">
            <h4>Type Parameters</h4>
            <div class="reflection-list">
              {entry.typeParameters.map((typeParameter) => (
                <div class="reflection-item">
                  <p class="reflection-item-name">
                    <code>
                      {typeParameter.name}
                      {typeParameter.constraint ? (
                        <>
                          {" extends "}
                          <ApiType type={typeParameter.type} />
                        </>
                      ) : null}
                      {typeParameter.defaultValue ? (
                        <>
                          {" = "}
                          <ApiType type={typeParameter.default} />
                        </>
                      ) : null}
                    </code>
                  </p>
                  {typeParameter.description ? (
                    <ApiMarkdown content={typeParameter.description} className="reflection-item-description" sourcePath={sourcePath} />
                  ) : null}
                </div>
              ))}
            </div>
          </section>
        ) : null}

        {entry.parameters.length > 0 ? (
          <section class="reflection-meta">
            <h4>Parameters</h4>
            <div class="reflection-table-wrap">
              <table class="reflection-table">
                <thead>
                  <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Default</th>
                  </tr>
                </thead>
                <tbody>
                  {entry.parameters.map((parameter) => {
                    const flags = parameter.flags ?? {};
                    const name = String(parameter.name || "parameter").trim();
                    const rest = flags.isRest ? "..." : "";
                    const optional = flags.isOptional && !flags.isRest ? "?" : "";
                    const description = getParameterDescriptionMarkdown(parameter);
                    const defaultValue = formatDefaultValue(parameter.defaultValue);

                    return (
                      <tr>
                        <td class="reflection-parameter-name"><code>{rest}{name}{optional}</code></td>
                        <td>
                          {description ? (
                            <ApiMarkdown content={description} className="reflection-item-description" sourcePath={sourcePath} />
                          ) : <span class="reflection-empty">—</span>}
                        </td>
                        <td class="reflection-default-value">
                          {defaultValue ? <code>{defaultValue}</code> : <span class="reflection-empty">—</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        ) : null}

        {entry.throws.length > 0 ? (
          <section class="reflection-meta">
            <h4>Throws</h4>
            <div class="reflection-list">
              {entry.throws.map((description) => (
                <div class="reflection-item">
                  <ApiMarkdown content={description} className="reflection-item-description" sourcePath={sourcePath} />
                </div>
              ))}
            </div>
          </section>
        ) : null}

        {entry.returnDescription ? (
          <section class="reflection-meta">
            <h4>Returns</h4>
            <ApiMarkdown content={entry.returnDescription} className="reflection-item-description" sourcePath={sourcePath} />
          </section>
        ) : null}

        {defaultValue ? (
          <p class="reflection-default">Default: <code>{defaultValue}</code></p>
        ) : null}

        {showTags && entry.tags.length > 0 ? (
          <ul class="tag-list">
            {entry.tags.map((tag) => <li><code>{tag}</code></li>)}
          </ul>
        ) : null}
      </div>
    ))}
  </article>
) : null}

<style>
  .api-reflection {
    display: grid;
    gap: 0.9rem;
  }

  .api-reflection-entry {
    display: grid;
    gap: 0.9rem;
  }

  .api-reflection-entry + .api-reflection-entry {
    padding-top: 0.9rem;
  }

  .reflection-default {
    margin: 0;
  }

  .reflection-meta {
    display: grid;
    gap: 0.45rem;
  }

  .reflection-meta h4 {
    margin: 0;
    color: var(--text);
    font-weight: 700;
    line-height: 1.25;
  }

  .reflection-list {
    display: grid;
    gap: 0.7rem;
  }

  .reflection-table-wrap {
    overflow-x: auto;
  }

  .reflection-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 0.35rem;
    text-align: left;
  }

  .reflection-table th {
    padding: 0 0.75rem 0.15rem;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reflection-table td {
    padding: 0.7rem 0.75rem;
    background: var(--surface-3);
    color: var(--muted);
    vertical-align: top;
  }

  .reflection-table td:first-child {
    width: 20%;
    border-radius: 0.35rem 0 0 0.35rem;
  }

  .reflection-table td:last-child {
    width: 20%;
    border-radius: 0 0.35rem 0.35rem 0;
    white-space: nowrap;
  }

  .reflection-parameter-name code,
  .reflection-default-value code {
    color: var(--code-text);
  }

  .reflection-empty {
    color: var(--muted);
  }

  @media (max-width: 44rem) {
    .reflection-table {
      min-width: 38rem;
    }
  }

  .reflection-item {
    display: grid;
    gap: 0.25rem;
  }

  .reflection-item-name {
    margin: 0;
    color: var(--text);
    line-height: 1.55;
  }

  .reflection-item-name code,
  .reflection-default code {
    display: inline-block;
    padding: 0.12rem 0.3rem;
    background: var(--code-bg);
    color: var(--code-text);
  }

  .reflection-flag {
    display: inline-block;
    margin-right: 0.45rem;
    padding: 0.12rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
  }

  .tag-list li {
    padding: 0.25rem 0.4rem;
    border: 1px solid var(--border);
    background: var(--surface-3);
  }

  .tag-list code {
    color: var(--text);
    font-size: 0.82rem;
  }
</style>
