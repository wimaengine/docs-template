---
import { getTypeParameters, ReflectionKind } from "../utils/typedoc.ts";
import type { JSONOutput } from "typedoc";
import ApiType from "./ApiType.astro";

interface Props {
  reflection: JSONOutput.DeclarationReflection;
}

const { reflection } = Astro.props as Props;
const typeParameters = getTypeParameters(reflection);
const isTypeAlias = reflection.kind === ReflectionKind.TypeAlias;
const type = reflection.type ?? "unknown";
---

<code class="api-declaration">
  {isTypeAlias ? "type " : null}{reflection.name}
  {typeParameters.length > 0 ? (
    <>
      {"<"}
      {typeParameters.map((typeParameter, index) => (
        <>
          {index > 0 ? ", " : null}
          {typeParameter.name}
          {typeParameter.constraint ? (
            <>
              {" extends "}
                <ApiType type={typeParameter.type} />
            </>
          ) : null}
          {typeParameter.defaultValue ? (
            <>
              {" = "}
                <ApiType type={typeParameter.default} />
            </>
          ) : null}
        </>
      ))}
      {">"}
    </>
  ) : null}
  {isTypeAlias ? " = " : ": "}
  <ApiType type={type} />
</code>

<style>
  .api-declaration {
    display: block;
    color: var(--code-text);
    font: inherit;
    font-weight: 600;
    white-space: normal;
  }
</style>
