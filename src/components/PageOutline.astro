---
import { escape } from "html-escaper";

interface HeadingLike {
  depth: number;
  slug: string;
  text: string;
}

interface OutlineNode {
  heading: HeadingLike;
  children: OutlineNode[];
}

interface Props {
  headings?: HeadingLike[];
}

const { headings = [] } = Astro.props as Props;
const visibleHeadings = headings.filter((heading) => heading.depth > 1);

function buildOutlineTree(items: HeadingLike[]): OutlineNode[] {
  const roots: OutlineNode[] = [];
  const stack: OutlineNode[] = [];

  for (const heading of items) {
    const node: OutlineNode = { heading, children: [] };

    while (stack.length > 0 && stack[stack.length - 1].heading.depth >= heading.depth) {
      stack.pop();
    }

    if (stack.length === 0) {
      roots.push(node);
    } else {
      stack[stack.length - 1].children.push(node);
    }

    stack.push(node);
  }

  return roots;
}

function renderNodes(nodes: OutlineNode[]): string {
  return nodes
    .map(({ heading, children }) => {
      const childHtml = children.length > 0
        ? `<ul class="page-outline-list">${renderNodes(children)}</ul>`
        : "";

      return `<li><a href="#${escape(heading.slug)}">${escape(heading.text)}</a>${childHtml}</li>`;
    })
    .join("");
}

const outline = buildOutlineTree(visibleHeadings);
const outlineHtml = outline.length > 0
  ? `<ul class="page-outline-list">${renderNodes(outline)}</ul>`
  : "";
---

{outlineHtml && (
  <aside class="page-outline">
    <p class="page-outline-label">On this page</p>
    <nav aria-label="Page headings" set:html={outlineHtml} />
  </aside>
)}

<style is:global>
  .page-outline {
    position: fixed;
    top: var(--site-header-height);
    right: 0;
    z-index: 800;
    display: grid;
    align-content: start;
    gap: 0;
    width: var(--page-outline-width);
    height: calc(100vh - var(--site-header-height));
    overflow-y: auto;
    overflow-anchor: none;
    padding: 1.25rem 1rem;
    border: 1px solid var(--border);
    background: var(--panel);
  }

  .page-outline-label {
    margin: 0 0 0.45rem;
    color: var(--accent-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .page-outline-list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .page-outline-list .page-outline-list {
    padding-left: 0.75rem;
  }

  .page-outline-list a {
    display: block;
    padding: 0.4rem 0.55rem;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .page-outline-list a:hover,
  .page-outline-list a:focus-visible {
    color: var(--accent);
    border-left-color: var(--accent);
    background: rgba(125, 211, 252, 0.08);
  }

  @media (max-width: 1100px) {
    .page-outline {
      display: none;
    }
  }
</style>
