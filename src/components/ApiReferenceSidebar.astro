---
import { getApiRoutePath } from "../config/site.js";
import { withBase } from "../utils/url.js";

interface ApiSidebarItem {
  slug: string;
  name: string;
}

interface Props {
  groups: Array<[string, ApiSidebarItem[]]>;
  activeSlug?: string;
}

const { groups, activeSlug } = Astro.props as Props;

function formatKind(value: string): string {
  switch (value) {
    case "class":
      return "Classes";
    case "enum":
      return "Enums";
    case "constant":
      return "Constants";
    case "variable":
      return "Variables";
    case "function":
      return "Functions";
    case "typedef":
      return "Typedefs";
    default:
      return value;
  }
}
---

<nav class="api-sidebar" aria-label="API reference">
  <p class="api-sidebar-label">Reference</p>

  <div class="api-sidebar-groups">
    {groups.map(([kind, items]) => (
      <section class="api-sidebar-group">
        <h2>{formatKind(kind)}</h2>
        <ul class="api-sidebar-list">
          {items.map((item) => {
            const isActive = item.slug === activeSlug;

            return (
              <li>
                <a
                  href={withBase(getApiRoutePath(item.slug))}
                  class:list={{ "is-active": isActive }}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.name}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</nav>

<style>
  .api-sidebar {
    position: fixed;
    top: 0;
    right: 0;
    display: grid;
    gap: 0;
    align-self: start;
    width: 17.5rem;
    height: 100vh;
    overflow-y: auto;
    padding: 1.25rem 1rem;
    border: 1px solid var(--border);
    background: var(--surface-2);
  }

  .api-sidebar-label {
    margin: 0 0 0.45rem;
    color: var(--accent-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-sidebar-groups {
    display: grid;
    gap: 0;
  }

  .api-sidebar-group {
    display: grid;
    gap: 0;
  }

  .api-sidebar-group + .api-sidebar-group {
    margin-top: 0.65rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border);
  }

  .api-sidebar-group h2 {
    margin: 0 0 0.35rem;
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .api-sidebar-list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .api-sidebar-list a {
    display: block;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    text-decoration: none;
    line-height: 1.15;
    font-size: 0.92rem;
  }

  .api-sidebar-list a:hover {
    color: var(--accent);
    border-color: var(--border-strong);
    background: var(--surface-3);
  }

  .api-sidebar-list a.is-active {
    color: var(--accent);
    border-color: rgba(125, 211, 252, 0.38);
    background: rgba(125, 211, 252, 0.08);
  }

  .api-sidebar-list li {
    margin: 0;
  }

  @media (max-width: 1100px) {
    .api-sidebar {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
    }
  }
</style>
