---
import ApiMemberTitle from "./ApiMemberTitle.astro";
import ApiReflection from "./ApiReflection.astro";
import {
  getReflectionMemberBadge,
  getReflectionKindName,
  ReflectionKind
} from "../utils/typedoc.js";

interface TypeDocReflection {
  id: number;
  name: string;
  kind: number;
  [key: string]: any;
}

interface ApiTypeLink {
  id: number;
  name: string;
  slug: string;
}

interface MemberBucket {
  id: string;
  label: string;
  kind: "constructor" | "properties" | "methods" | "functions" | "additional";
  items: TypeDocReflection[];
}

interface Props {
  members: TypeDocReflection[];
  typeLinks?: ApiTypeLink[];
}

const { members, typeLinks = [] } = Astro.props as Props;

function createBucket(
  id: MemberBucket["id"],
  label: string,
  kind: MemberBucket["kind"],
  items: TypeDocReflection[]
): MemberBucket | null {
  return items.length > 0 ? { id, label, kind, items } : null;
}

const memberBuckets = [
  createBucket("constructor", "Constructor", "constructor", members.filter((member) => member.kind === ReflectionKind.Constructor)),
  createBucket(
    "properties",
    "Properties",
    "properties",
    members.filter((member) => member.kind === ReflectionKind.Property || member.kind === ReflectionKind.Accessor)
  ),
  createBucket("methods", "Methods", "methods", members.filter((member) => member.kind === ReflectionKind.Method)),
  createBucket(
    "functions",
    "Functions",
    "functions",
    members.filter((member) => [
      ReflectionKind.Function,
      ReflectionKind.CallSignature,
      ReflectionKind.ConstructorSignature
    ].includes(member.kind))
  ),
  createBucket(
    "additional",
    "Additional",
    "additional",
    members.filter((member) => ![
      ReflectionKind.Constructor,
      ReflectionKind.Property,
      ReflectionKind.Accessor,
      ReflectionKind.Method,
      ReflectionKind.Function,
      ReflectionKind.CallSignature,
      ReflectionKind.ConstructorSignature
    ].includes(member.kind))
  )
].filter((bucket): bucket is MemberBucket => bucket !== null);

const indexedMembers = memberBuckets.flatMap((bucket) => bucket.items);

function getIndexBadge(member: TypeDocReflection) {
  return getReflectionMemberBadge(member.kind) ?? {
    letter: getReflectionKindName(member.kind).charAt(0).toUpperCase(),
    name: getReflectionKindName(member.kind)
  };
}

function getIndexName(member: TypeDocReflection): string {
  if (member.kind === ReflectionKind.Constructor || member.kind === ReflectionKind.ConstructorSignature) {
    return "constructor";
  }

  return String(member.name || "member");
}

function shouldShowMemberKind(member: TypeDocReflection): boolean {
  return ![
    ReflectionKind.Constructor,
    ReflectionKind.Property,
    ReflectionKind.Accessor,
    ReflectionKind.Method,
    ReflectionKind.Function,
    ReflectionKind.CallSignature,
    ReflectionKind.ConstructorSignature
  ].includes(member.kind);
}
---

<div class="api-sections">
  {indexedMembers.length > 0 ? (
    <details class="api-group api-member-index" id="index" open>
      <summary class="api-group-summary">
        <h2 class="api-group-title">Index</h2>
        <span class="api-group-toggle" aria-hidden="true">›</span>
      </summary>
      <hr class="api-group-rule" />
      <nav aria-label="Member index">
        <ul class="api-member-index-list">
          {indexedMembers.map((member) => {
            const badge = getIndexBadge(member);

            return (
              <li>
                <a class="api-member-index-link" href={`#member-${member.id}`}>
                  <span class="api-member-index-badge" title={badge.name}>{badge.letter}</span>
                  <span class="api-member-index-name">{getIndexName(member)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </details>
  ) : null}

  {memberBuckets.map((bucket) => (
    <details class="api-group" id={bucket.id} open>
      <summary class="api-group-summary">
        <h2 class="api-group-title">{bucket.label}</h2>
        <span class="api-group-toggle" aria-hidden="true">›</span>
      </summary>
      <hr class="api-group-rule" />
      <div class="member-list">
        {bucket.items.map((member) => (
          <article class="member-section" id={`member-${member.id}`}>
            <header class="member-header">
              <h3>
                <ApiMemberTitle
                  reflection={member}
                  name={bucket.kind === "constructor" ? "constructor" : undefined}
                  typeLinks={typeLinks}
                />
              </h3>
              {shouldShowMemberKind(member) ? (
                <p class="member-kind">{getReflectionKindName(member.kind)}</p>
              ) : null}
            </header>
            <ApiReflection reflection={member} typeLinks={typeLinks} />
          </article>
        ))}
      </div>
    </details>
  ))}
</div>

<style>
  .api-sections {
    display: grid;
    gap: 1.25rem;
  }

  .api-member-index {
    scroll-margin-top: 1rem;
  }

  .api-member-index-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .api-member-index-link {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.5rem;
    padding: 0.25rem 0.1rem;
    color: var(--text);
    text-decoration: none;
  }

  .api-member-index-link:hover,
  .api-member-index-link:focus-visible {
    color: var(--accent);
  }

  .api-member-index-badge {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    padding: 0.12rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
  }

  .api-member-index-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .api-group {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  .api-group-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .api-group-summary::-webkit-details-marker {
    display: none;
  }

  .api-group-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .api-group-title,
  .member-header h3 {
    margin: 0;
    padding: 0;
    color: var(--text);
    line-height: 1.2;
  }

  .api-group-rule {
    display: block;
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .api-group-toggle {
    flex: 0 0 auto;
    color: var(--accent-secondary);
    font-size: 1.35rem;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .api-group[open] .api-group-toggle {
    transform: rotate(90deg);
  }

  .member-list {
    display: grid;
    gap: 1rem;
  }

  .member-section {
    display: grid;
    gap: 0.65rem;
    padding-top: 0.95rem;
    scroll-margin-top: 1rem;
  }

  .member-header {
    display: grid;
    gap: 0.25rem;
  }

  .member-kind {
    margin: 0;
    color: var(--accent-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .api-member-index-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .api-member-index-list {
      grid-template-columns: 1fr;
    }
  }
</style>
