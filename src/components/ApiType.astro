---
import { getLink } from "../config/links.ts";
import { withBase } from "../utils/url.ts";
import type { JSONOutput } from "typedoc";

interface TypePart {
  text: string;
  href?: string;
}

interface Props {
  type?: JSONOutput.SomeType | string;
}

const { type } = Astro.props as Props;

interface ResolvedTypeLink {
  href?: string;
}

function toHref(route: string | undefined): string | undefined {
  if (!route) {
    return undefined;
  }

  return /^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(route) ? route : withBase(route);
}

function getReferenceLink(
  reference: Extract<JSONOutput.SomeType, { type: "reference" }>
): ResolvedTypeLink | undefined {
  const names = [
    reference.name,
    reference.qualifiedName
  ].filter((name): name is string => Boolean(name));

  for (const name of names) {
    const href = toHref(getLink(name));
    if (href) {
      return { href };
    }
  }

  return undefined;
}

function textPart(text: string): TypePart[] {
  return [{ text }];
}

function linkedTextPart(text: string): TypePart[] {
  const href = toHref(getLink(text));
  return href ? [{ text, href }] : textPart(text);
}

function joinTypeParts(types: JSONOutput.SomeType[], separator: string): TypePart[] {
  return types.flatMap((item, index) => [
    ...(index > 0 ? textPart(separator) : []),
    ...getTypeParts(item)
  ]);
}

function formatLiteralValue(
  value: Extract<JSONOutput.SomeType, { type: "literal" }>["value"]
): string {
  if (value === null) {
    return "null";
  }

  if (typeof value === "string") {
    return JSON.stringify(value);
  }

  return `${value}`;
}

function getTypeParts(value: JSONOutput.SomeType | string | undefined): TypePart[] {
  if (!value) {
    return [];
  }

  if (typeof value === "string") {
    const href = toHref(getLink(value));
    return href ? [{ text: value, href }] : textPart(value);
  }

  switch (value.type) {
    case "intrinsic":
      return linkedTextPart(value.name ?? "unknown");
    case "reference": {
      const name = value.name ?? value.qualifiedName ?? "unknown";
      const link = getReferenceLink(value);
      const parts: TypePart[] = [{
        text: name,
        href: link?.href
      }];
      const typeArguments = value.typeArguments ?? [];

      if (typeArguments.length === 0) {
        return parts;
      }

      return [
        ...parts,
        ...textPart("<"),
        ...joinTypeParts(typeArguments, ", "),
        ...textPart(">")
      ];
    }
    case "array": {
      const elementParts = getTypeParts(value.elementType);
      const needsGrouping = value.elementType?.type === "union" || value.elementType?.type === "intersection";

      return [
        ...(needsGrouping ? textPart("(") : []),
        ...elementParts,
        ...(needsGrouping ? textPart(")") : []),
        ...textPart("[]")
      ];
    }
    case "union":
      return joinTypeParts(value.types ?? [], " | ");
    case "intersection":
      return joinTypeParts(value.types ?? [], " & ");
    case "tuple":
      return [
        ...textPart("["),
        ...joinTypeParts(value.elements ?? [], ", "),
        ...textPart("]")
      ];
    case "literal":
      return linkedTextPart(formatLiteralValue(value.value));
    case "typeOperator":
      return [
        ...textPart(`${value.operator ?? ""} `.trimEnd() + " "),
        ...getTypeParts(value.target)
      ];
    case "indexedAccess":
      return [
        ...getTypeParts(value.objectType),
        ...textPart("["),
        ...getTypeParts(value.indexType),
        ...textPart("]")
      ];
    case "query":
      return [
        ...textPart("typeof "),
        ...getTypeParts(value.queryType)
      ];
    case "conditional":
      return [
        ...getTypeParts(value.checkType),
        ...textPart(" extends "),
        ...getTypeParts(value.extendsType),
        ...textPart(" ? "),
        ...getTypeParts(value.trueType),
        ...textPart(" : "),
        ...getTypeParts(value.falseType)
      ];
    case "namedTupleMember":
      return [
        ...textPart(value.isRest ? "..." : ""),
        ...textPart(value.name ?? "item"),
        ...textPart(value.isOptional ? "?" : ""),
        ...textPart(": "),
        ...getTypeParts(value.element)
      ];
    case "optional":
      return [...getTypeParts(value.elementType), ...textPart("?")];
    case "rest":
      return [...textPart("..."), ...getTypeParts(value.elementType)];
    case "inferred":
      return textPart(`infer ${value.name ?? "T"}`);
    case "predicate":
      return [
        ...textPart(`${value.name ?? "value"} is `),
        ...getTypeParts(value.targetType)
      ];
    case "templateLiteral":
      return textPart(value.head ?? "template literal");
    case "reflection":
      return textPart("object");
    default: {
      const name = "name" in value && value.name
        ? value.name
        : "qualifiedName" in value
          ? value.qualifiedName
          : undefined;
      return name ? textPart(name) : textPart(value.type);
    }
  }
}

const parts = getTypeParts(type);

function getPartHref(part: TypePart): string | undefined {
  return part.href;
}
---

{parts.map((part) => {
  const href = getPartHref(part);
  return href ? (
    <a class="api-type-link" href={href}>{part.text}</a>
  ) : part.text;
})}

<style>
  .api-type-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.15em;
  }

  .api-type-link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
</style>
