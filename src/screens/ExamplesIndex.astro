---
import { rootPackageName } from "@configs/project.ts";
import { sidebarTabs } from "@configs";
import DocLayout from "@layouts/DocLayout.astro";
import ExampleTree from "../components/ExampleTree.astro";

interface ExampleTreeNode {
  id: string;
  label: string;
  examples: Array<{
    slug: string;
    title: string;
  }>;
  children: ExampleTreeNode[];
}

interface Props {
  nodes: ExampleTreeNode[];
}

const { nodes } = Astro.props as Props;
---

<DocLayout title={`Examples | ${rootPackageName}`} tabs={sidebarTabs}>
  <h1>Examples</h1>
  <p>Browse runnable examples from the repository.</p>

  <ExampleTree nodes={nodes} />
</DocLayout>
