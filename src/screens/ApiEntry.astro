---
import { rootPackageName } from "@configs/project.ts";
import { sidebarTabs } from "@configs";
import DocLayout from "@layouts/DocLayout.astro";
import ApiDeclaration from "../components/ApiDeclaration.astro";
import ApiMarkdown from "../components/ApiMarkdown.astro";
import ApiMemberGroups from "../components/ApiMemberGroups.astro";
import ApiMemberIndex from "../components/ApiMemberIndex.astro";
import ApiReflection from "../components/ApiReflection.astro";
import ApiSignature from "../components/ApiSignature.astro";
import ApiSurface from "../components/ApiSurface.astro";
import SourceLink from "../components/SourceLink.astro";
import { getSourceUrl } from "../utils/source-links.ts";
import {
  getReflectionDescriptionMarkdown,
  getReflectionKindLabel,
  getReflectionKindName,
  getReflectionSignatures,
  getReflectionTags,
  getVisibleReflectionChildren,
  ReflectionKind
} from "../utils/typedoc.ts";
import type { ApiCollectionEntry } from "../types.ts";

interface Props {
  entry: ApiCollectionEntry;
}

const { entry } = Astro.props as Props;
const reflection = entry.data;
const sourcePath = reflection.sources?.[0]?.fileName;
const source = reflection.sources?.[0];
const sourceUrl = getSourceUrl(entry.filePath || sourcePath, source?.line);
const signature = getReflectionSignatures(reflection)[0];
const description = getReflectionDescriptionMarkdown(reflection, signature);
const tags = getReflectionTags(reflection, signature);
const children = getVisibleReflectionChildren(reflection);
const title = `${getReflectionKindLabel(reflection.kind)} ${reflection.name}`;
---

<DocLayout
  title={`${title} | ${rootPackageName}`}
  description={description}
  tabs={sidebarTabs}
  type="article"
  rightPanel={children.length > 0 ? "api" : undefined}
>
  <ApiSurface>
    <div class="api-page">
      <header class="api-header">
        <p class="section-label">{getReflectionKindName(reflection.kind)}</p>
        <h1>{reflection.name}</h1>
        {sourceUrl ? <SourceLink href={sourceUrl} /> : null}
        {reflection.kind === ReflectionKind.Function ? (
          <ApiSignature reflection={reflection} />
        ) : [ReflectionKind.Variable, ReflectionKind.TypeAlias].includes(reflection.kind) ? (
          <ApiDeclaration reflection={reflection} />
        ) : null}
        {description ? <ApiMarkdown content={description} className="lead" sourcePath={sourcePath} /> : null}
        {tags.length > 0 ? (
          <div class="notes">
            {tags.map((tag) => <p><code>{tag}</code></p>)}
          </div>
        ) : null}
      </header>

      <section class="api-section api-definition">
        <ApiReflection reflection={reflection} showDescription={false} showTags={false} />
      </section>

      {children.length > 0 ? <ApiMemberGroups members={children} /> : null}
    </div>
  </ApiSurface>
  <ApiMemberIndex slot="right-panel" members={children} typeName={reflection.name} />
</DocLayout>

<style>
  .api-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 70rem;
  }

  .api-header {
    display: grid;
    gap: 0.65rem;
    padding-bottom: 1.1rem;
  }

  .api-header h1 {
    margin: 0;
  }

  .section-label,
  .member-kind {
    margin: 0;
    color: var(--accent-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-header .lead {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .api-header > .api-signature {
    display: block;
    margin: 0;
  }

  .api-header > .api-declaration {
    margin: 0;
  }

  .notes {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .notes p,
  .api-page p {
    margin: 0;
  }

  .api-section,
  .api-group {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  .api-definition {
    padding-top: 0;
  }

</style>
