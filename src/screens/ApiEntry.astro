---
import { rootPackageName } from "@configs/project.js";
import { sidebarTabs } from "@configs";
import DocLayout from "@layouts/DocLayout.astro";
import ApiSurface from "../components/ApiSurface.astro";
import ApiReflection from "../components/ApiReflection.astro";
import {
  getReflectionDescriptionForDisplay,
  getReflectionKindLabel,
  getReflectionKindName,
  getReflectionTagsForDisplay,
  getVisibleReflectionChildren
} from "../utils/typedoc.js";

interface TypeDocReflection {
  id: number;
  name: string;
  kind: number;
  [key: string]: any;
}

interface ApiCollectionEntry {
  id: string;
  data: TypeDocReflection;
}

interface ApiTypeLink {
  id: number;
  name: string;
  slug: string;
}

interface Props {
  entry: ApiCollectionEntry;
  groups: Array<[string, Array<{ slug: string; name: string }>]>;
  typeLinks: ApiTypeLink[];
}

const { entry, groups, typeLinks } = Astro.props as Props;
const reflection = entry.data;
const description = getReflectionDescriptionForDisplay(reflection);
const tags = getReflectionTagsForDisplay(reflection);
const children = getVisibleReflectionChildren(reflection);
const title = `${getReflectionKindLabel(reflection.kind)} ${reflection.name}`;
---

<DocLayout title={`${title} | ${rootPackageName}`} tabs={sidebarTabs}>
  <ApiSurface groups={groups} activeSlug={entry.id}>
    <div class="api-page">
      <header class="api-header">
        <p class="section-label">{getReflectionKindName(reflection.kind)}</p>
        <h1>{reflection.name}</h1>
        {description ? <p class="lead">{description}</p> : null}
        {tags.length > 0 ? (
          <div class="notes">
            {tags.map((tag) => <p><code>{tag}</code></p>)}
          </div>
        ) : null}
      </header>

      <section class="api-section api-definition">
        <ApiReflection reflection={reflection} showDescription={false} showTags={false} typeLinks={typeLinks} />
      </section>

      {children.length > 0 ? (
        <section class="api-group">
          <h2>Members</h2>
          <div class="member-list">
            {children.map((child) => (
              <article class="member-section" id={`member-${child.id}`}>
                <header class="member-header">
                  <h3>{child.name}</h3>
                  <p class="member-kind">{getReflectionKindName(child.kind)}</p>
                </header>
                <ApiReflection reflection={child} typeLinks={typeLinks} />
              </article>
            ))}
          </div>
        </section>
      ) : null}
    </div>
  </ApiSurface>
</DocLayout>

<style>
  .api-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 70rem;
  }

  .api-header {
    display: grid;
    gap: 0.65rem;
    padding-bottom: 1.1rem;
  }

  .api-header h1 {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3.4rem);
    line-height: 1.05;
  }

  .section-label,
  .member-kind {
    margin: 0;
    color: var(--accent-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-header .lead {
    max-width: 70ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .notes {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .notes p,
  .api-page p {
    margin: 0;
  }

  .api-section,
  .api-group {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  .api-definition {
    padding-top: 0;
  }

  .api-group h2,
  .member-header h3 {
    margin: 0;
    color: var(--text);
    line-height: 1.2;
  }

  .api-group h2 {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .member-list {
    display: grid;
    gap: 1rem;
  }

  .member-section {
    display: grid;
    gap: 0.65rem;
    padding-top: 0.95rem;
  }

  .member-header {
    display: grid;
    gap: 0.25rem;
  }

  .member-header h3 {
    font-size: 1.2rem;
  }
</style>
