---
import { rootPackageName } from "@configs/project.js";
import { sidebarTabs } from "@configs";
import ApiExamples from "../components/ApiExamples.astro";
import ApiMarkdown from "../components/ApiMarkdown.astro";
import DocLayout from "@layouts/DocLayout.astro";
import ApiReflection from "../components/ApiReflection.astro";
import ApiMemberIndex from "../components/ApiMemberIndex.astro";
import ApiSurface from "../components/ApiSurface.astro";
import {
  getReflectionDescriptionMarkdown,
  getReflectionSignatures,
  getReflectionTags,
  getVisibleReflectionChildren,
  ReflectionKind
} from "../utils/typedoc.js";

interface TypeDocReflection {
  id: number;
  name: string;
  kind: number;
  [key: string]: any;
}

interface ApiCollectionEntry {
  id: string;
  data: TypeDocReflection;
}

interface Props {
  entry: ApiCollectionEntry;
}

const { entry } = Astro.props as Props;
const reflection = entry.data;
const sourcePath = reflection.sources?.[0]?.fileName;
const signature = getReflectionSignatures(reflection)[0];
const description = getReflectionDescriptionMarkdown(reflection, signature);
const tags = getReflectionTags(reflection, signature);
const members = getVisibleReflectionChildren(reflection)
  .filter((member) => member.kind === ReflectionKind.EnumMember);
---

<DocLayout
  title={`Enum ${reflection.name} | ${rootPackageName}`}
  tabs={sidebarTabs}
  rightPanel={members.length > 0 ? "api" : undefined}
>
  <ApiSurface>
    <div class="api-page">
      <header class="api-header">
        <p class="section-label">Enum</p>
        <h1>{reflection.name}</h1>
        {description ? <ApiMarkdown content={description} className="lead" sourcePath={sourcePath} /> : null}
        {tags.length > 0 ? (
          <div class="notes">
            {tags.map((tag) => <p><code>{tag}</code></p>)}
          </div>
        ) : null}
        <ApiExamples reflection={reflection} />
      </header>

      {members.length > 0 ? (
        <details class="api-group" id="variants" open>
          <summary class="api-group-summary">
            <h2 class="api-group-title">Variants</h2>
            <span class="api-group-toggle" aria-hidden="true">›</span>
          </summary>
          <hr class="api-group-rule" />
          <div class="member-list">
            {members.map((member) => (
              <article class="member-section" id={`member-${member.id}`}>
                <header class="member-header">
                  <h3>{member.name}</h3>
                </header>
                <ApiReflection reflection={member} />
              </article>
            ))}
          </div>
        </details>
      ) : null}
    </div>
  </ApiSurface>
  <ApiMemberIndex slot="right-panel" members={members} typeName={reflection.name} />
</DocLayout>

<style>
  .api-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 70rem;
  }

  .api-header {
    display: grid;
    gap: 0.65rem;
    padding-bottom: 1.1rem;
  }

  .api-header h1 {
    margin: 0;
  }

  .section-label {
    margin: 0;
    color: var(--accent-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-header .lead,
  .api-page p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .notes {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .notes p {
    color: var(--text);
  }

  .api-group {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  .api-group-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .api-group-summary::-webkit-details-marker {
    display: none;
  }

  .api-group-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .api-group-title,
  .member-header h3 {
    margin: 0;
    padding: 0;
    color: var(--text);
    line-height: 1.2;
  }

  .api-group-rule {
    display: block;
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .api-group-toggle {
    flex: 0 0 auto;
    color: var(--accent-secondary);
    font-size: 1.35rem;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .api-group[open] .api-group-toggle {
    transform: rotate(90deg);
  }

  .member-list {
    display: grid;
    gap: 1rem;
  }

  .member-section {
    display: grid;
    gap: 0.65rem;
    padding-top: 0.95rem;
  }

</style>
