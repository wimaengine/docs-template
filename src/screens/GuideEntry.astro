---
import { render } from "astro:content";
import { rootPackageName } from "@configs/project.ts";
import { sidebarTabs } from "@configs";
import GuidePagination from "@components/GuidePagination.astro";
import DocLayout from "@layouts/DocLayout.astro";
import type { GuideCollectionEntry } from "../types.ts";

interface Props {
  entry: GuideCollectionEntry;
}

const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<DocLayout
  title={`${entry.data.title} | ${rootPackageName}`}
  description={entry.data.description}
  image={entry.data.ogImage}
  noindex={entry.data.noindex}
  tabs={sidebarTabs}
  headings={headings}
  type="article"
>
  <Content />
  <GuidePagination />
</DocLayout>
