---
import { render } from "astro:content";
import { rootPackageName } from "@configs/project.js";
import { sidebarTabs } from "@configs";
import GuidePagination from "@components/GuidePagination.astro";
import DocLayout from "@layouts/DocLayout.astro";

interface GuideCollectionEntry {
  data: {
    title: string;
  };
}

interface Props {
  entry: GuideCollectionEntry;
}

const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<DocLayout title={`${entry.data.title} | ${rootPackageName}`} tabs={sidebarTabs} headings={headings}>
  <Content />
  <GuidePagination />
</DocLayout>
