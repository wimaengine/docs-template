---
import { rootPackageName } from "@configs/project.js";
import { sidebarTabs } from "@configs";
import DocLayout from "@layouts/DocLayout.astro";
import ApiMemberGroups from "../components/ApiMemberGroups.astro";
import ApiSurface from "../components/ApiSurface.astro";
import {
  getReflectionDescriptionForDisplay,
  getReflectionKindName,
  getReflectionTagsForDisplay,
  getVisibleReflectionChildren
} from "../utils/typedoc.js";

interface TypeDocReflection {
  id: number;
  name: string;
  kind: number;
  [key: string]: any;
}

interface ApiCollectionEntry {
  id: string;
  data: TypeDocReflection;
}

interface ApiTypeLink {
  id: number;
  name: string;
  slug: string;
}

interface Props {
  entry: ApiCollectionEntry;
  groups: Array<[string, Array<{ slug: string; name: string }>]>;
  typeLinks: ApiTypeLink[];
}

const { entry, groups, typeLinks } = Astro.props as Props;
const reflection = entry.data;
const members = getVisibleReflectionChildren(reflection);
const description = getReflectionDescriptionForDisplay(reflection);
const tags = getReflectionTagsForDisplay(reflection);
---

<DocLayout title={`${getReflectionKindName(reflection.kind)} ${reflection.name} | ${rootPackageName}`} tabs={sidebarTabs}>
  <ApiSurface groups={groups} activeSlug={entry.id}>
    <div class="api-page">
      <header class="api-header">
        <p class="section-label">{getReflectionKindName(reflection.kind)}</p>
        <h1>{reflection.name}</h1>
        {description ? <p class="lead">{description}</p> : null}
        {tags.length > 0 ? (
          <div class="notes">
            {tags.map((tag) => <p><code>{tag}</code></p>)}
          </div>
        ) : null}
      </header>

      <ApiMemberGroups members={members} typeLinks={typeLinks} />
    </div>
  </ApiSurface>
</DocLayout>

<style>
  .api-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 70rem;
  }

  .api-header {
    display: grid;
    gap: 0.65rem;
    padding-bottom: 1.1rem;
  }

  .api-header h1 {
    margin: 0;
  }

  .section-label,
  .member-kind {
    margin: 0;
    color: var(--accent-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-header .lead,
  .api-page p {
    max-width: 70ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .notes {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .notes p {
    color: var(--text);
  }

</style>
