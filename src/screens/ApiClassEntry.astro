---
import { rootPackageName } from "@configs/project.js";
import { sidebarTabs } from "@configs";
import DocLayout from "@layouts/DocLayout.astro";
import ApiSurface from "../components/ApiSurface.astro";
import ApiReflection from "../components/ApiReflection.astro";
import {
  getReflectionDescriptionForDisplay,
  getReflectionKindName,
  getReflectionTagsForDisplay,
  getVisibleReflectionChildren,
  ReflectionKind
} from "../utils/typedoc.js";

interface TypeDocReflection {
  id: number;
  name: string;
  kind: number;
  [key: string]: any;
}

interface ApiCollectionEntry {
  id: string;
  data: TypeDocReflection;
}

interface MemberBucket {
  id: string;
  label: string;
  kind: "constructor" | "properties" | "methods" | "additional";
  items: TypeDocReflection[];
}

interface Props {
  entry: ApiCollectionEntry;
  groups: Array<[string, Array<{ slug: string; name: string }>]>;
}

const { entry, groups } = Astro.props as Props;
const reflection = entry.data;
const members = getVisibleReflectionChildren(reflection);
const description = getReflectionDescriptionForDisplay(reflection);
const tags = getReflectionTagsForDisplay(reflection);

function createBucket(
  id: MemberBucket["id"],
  label: string,
  kind: MemberBucket["kind"],
  items: TypeDocReflection[]
): MemberBucket | null {
  return items.length > 0 ? { id, label, kind, items } : null;
}

function getMemberModifiers(member: TypeDocReflection): string[] {
  const flags = member.flags ?? {};

  return [
    flags.isStatic ? "static" : null,
    flags.isAbstract ? "abstract" : null,
    flags.isReadonly ? "readonly" : null,
    flags.isOptional ? "optional" : null
  ].filter((modifier): modifier is string => modifier !== null);
}

const memberBuckets = [
  createBucket("constructor", "Constructor", "constructor", members.filter((member) => member.kind === ReflectionKind.Constructor)),
  createBucket(
    "properties",
    "Properties",
    "properties",
    members.filter((member) => member.kind === ReflectionKind.Property || member.kind === ReflectionKind.Accessor)
  ),
  createBucket("methods", "Methods", "methods", members.filter((member) => member.kind === ReflectionKind.Method)),
  createBucket(
    "additional",
    "Additional",
    "additional",
    members.filter((member) => ![
      ReflectionKind.Constructor,
      ReflectionKind.Property,
      ReflectionKind.Accessor,
      ReflectionKind.Method
    ].includes(member.kind))
  )
].filter((bucket): bucket is MemberBucket => bucket !== null);
---

<DocLayout title={`Class ${reflection.name} | ${rootPackageName}`} tabs={sidebarTabs}>
  <ApiSurface groups={groups} activeSlug={entry.id}>
    <div class="api-page">
      <header class="api-header">
        <p class="section-label">Class</p>
        <h1>{reflection.name}</h1>
        {description ? <p class="lead">{description}</p> : null}
        {tags.length > 0 ? (
          <div class="notes">
            {tags.map((tag) => <p><code>{tag}</code></p>)}
          </div>
        ) : null}
      </header>

      <div class="api-sections">
        {memberBuckets.map((bucket) => (
          <details class="api-group" id={bucket.id} open>
            <summary class="api-group-summary">
              <span class="api-group-title" role="heading" aria-level="2">{bucket.label}</span>
              <span class="api-group-toggle" aria-hidden="true">›</span>
            </summary>
            <div class="member-list">
              {bucket.items.map((member) => (
                <article class="member-section" id={`member-${member.id}`}>
                  {bucket.kind === "constructor" ? null : (
                    <header class="member-header">
                      <h3>
                        {getMemberModifiers(member).map((modifier) => (
                          <span class="member-modifier">{modifier}</span>
                        ))}
                        <span>{member.name}</span>
                      </h3>
                      {bucket.kind === "properties" ? null : (
                        <p class="member-kind">{getReflectionKindName(member.kind)}</p>
                      )}
                    </header>
                  )}
                  <ApiReflection reflection={member} />
                </article>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </ApiSurface>
</DocLayout>

<style>
  .api-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 70rem;
  }

  .api-header {
    display: grid;
    gap: 0.65rem;
    padding-bottom: 1.1rem;
  }

  .api-header h1 {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3.4rem);
    line-height: 1.05;
  }

  .section-label,
  .member-kind {
    margin: 0;
    color: var(--accent-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-header .lead,
  .api-page p {
    max-width: 70ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .notes {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .notes p {
    color: var(--text);
  }

  .api-sections {
    display: grid;
    gap: 1.25rem;
  }

  .api-group {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  .api-group-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .api-group-summary::-webkit-details-marker {
    display: none;
  }

  .api-group-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .api-group-title,
  .member-header h3 {
    margin: 0;
    color: var(--text);
    line-height: 1.2;
  }

  .api-group-title {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .api-group-toggle {
    flex: 0 0 auto;
    color: var(--accent-secondary);
    font-size: 1.35rem;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .api-group[open] .api-group-toggle {
    transform: rotate(90deg);
  }

  .member-list {
    display: grid;
    gap: 1rem;
  }

  .member-section {
    display: grid;
    gap: 0.65rem;
    padding-top: 0.95rem;
  }

  .member-header {
    display: grid;
    gap: 0.25rem;
  }

  .member-header h3 {
    font-size: 1.2rem;
  }

  .member-modifier {
    display: inline-block;
    margin-right: 0.55rem;
    vertical-align: baseline;
    color: var(--accent-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
