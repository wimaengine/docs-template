---
import { getCollection, render } from "astro:content";
import { rootPackageName } from "@configs/project.ts";
import { sidebarTabs } from "@configs";
import DocLayout from "@layouts/DocLayout.astro";
import type { IntroCollectionEntry } from "../types.ts";

const introEntries = (await getCollection("intro")) as IntroCollectionEntry[];
const introEntry = introEntries[0];

if (!introEntry) {
  throw new Error("Missing introduction entry");
}

const { Content, headings } = await render(introEntry);
---

<DocLayout title={rootPackageName} tabs={sidebarTabs} headings={headings}>
  <Content />
</DocLayout>
