---
import { getCollection } from "astro:content";
import {
  assertUniqueApiEntryRoutes,
  getApiEntryRoute,
  getApiPackageRoute,
  getApiRoutePath,
  getExamplesRoutePath,
  getGuideEntryRoute,
  getGuideRoutePath,
  routeToParam
} from "@configs/site.js";
import { withBase } from "../utils/url.js";
import { ReflectionKind } from "../utils/typedoc.js";
import GuideIndex from "../screens/GuideIndex.astro";
import GuideEntry from "../screens/GuideEntry.astro";
import ExamplesIndex from "../screens/ExamplesIndex.astro";
import ExampleEntry from "../screens/ExampleEntry.astro";
import ApiIndex from "../screens/ApiIndex.astro";
import ApiPackageEntry from "../screens/ApiPackageEntry.astro";
import ApiClassEntry from "../screens/ApiClassEntry.astro";
import ApiEnumEntry from "../screens/ApiEnumEntry.astro";
import ApiEntry from "../screens/ApiEntry.astro";

interface GuideCollectionEntry {
  id: string;
  slug?: string;
  body: string;
  data: {
    title: string;
  };
}

interface ExampleCollectionEntry {
  id: string;
  data: {
    title: string;
    filePath: string;
    source: string;
  };
}

interface ExampleTreeNode {
  id: string;
  label: string;
  examples: Array<{
    slug: string;
    title: string;
  }>;
  children: ExampleTreeNode[];
}

interface TypeDocReflection {
  id: number;
  name: string;
  kind: number;
  [key: string]: any;
}

interface ApiCollectionEntry {
  id: string;
  filePath: string;
  data: TypeDocReflection;
}

interface ApiPackageCollectionEntry {
  id: string;
  body: string;
  data: {
    title: string;
  };
}

type PageKind =
  | "guide-index"
  | "guide-entry"
  | "examples-index"
  | "example-entry"
  | "api-index"
  | "api-package-entry"
  | "api-class-entry"
  | "api-enum-entry"
  | "api-entry";

interface StaticProps {
  kind: PageKind;
  entry?: GuideCollectionEntry | ExampleCollectionEntry | ApiCollectionEntry | ApiPackageCollectionEntry;
}

function slugifyExampleSegment(value: string): string {
  return value
    .replace(/([a-z0-9])([A-Z])/g, "$1-$2")
    .replace(/[^a-zA-Z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .toLowerCase();
}

function createExampleTree(examples: ExampleCollectionEntry[]): ExampleTreeNode[] {
  const root: ExampleTreeNode = {
    id: "",
    label: "",
    examples: [],
    children: []
  };

  for (const entry of examples) {
    const segments = entry.id.split("/").filter(Boolean);
    segments.pop();
    let node = root;

    for (const segment of segments) {
      let child = node.children.find((candidate) => candidate.label === segment);

      if (!child) {
        const segmentId = slugifyExampleSegment(segment);
        child = {
          id: node.id ? `${node.id}-${segmentId}` : segmentId,
          label: segment,
          examples: [],
          children: []
        };
        node.children.push(child);
      }

      node = child;
    }

    node.examples.push({
      slug: entry.id,
      title: entry.data.title
    });
  }

  function sortTree(nodes: ExampleTreeNode[]) {
    nodes.sort((a, b) => a.label.localeCompare(b.label));

    for (const node of nodes) {
      node.examples.sort((a, b) => a.title.localeCompare(b.title));
      sortTree(node.children);
    }
  }

  sortTree(root.children);
  return root.children;
}

export async function getStaticPaths() {
  const [guideEntriesForPaths, exampleEntriesForPaths, apiEntriesForPaths, apiPackageEntriesForPaths] = await Promise.all([
    getCollection("guide"),
    getCollection("examples"),
    getCollection("api"),
    getCollection("apiPackages")
  ]) as [
    GuideCollectionEntry[],
    ExampleCollectionEntry[],
    ApiCollectionEntry[],
    ApiPackageCollectionEntry[]
  ];
  const guideRootForPaths = getGuideRoutePath();
  const examplesRootForPaths = getExamplesRoutePath();
  const apiRootForPaths = getApiRoutePath();

  assertUniqueApiEntryRoutes(apiEntriesForPaths);

  return [
    ...guideEntriesForPaths.map((entry) => {
      const route = getGuideEntryRoute(entry);
      return route === guideRootForPaths
        ? {
            params: { page: routeToParam(guideRootForPaths) },
            props: { kind: "guide-index", entry }
          }
        : {
            params: { page: routeToParam(route) },
            props: { kind: "guide-entry", entry }
          };
    }),
    {
      params: { page: routeToParam(examplesRootForPaths) },
      props: { kind: "examples-index" }
    },
    ...exampleEntriesForPaths.map((entry) => ({
      params: { page: routeToParam(getExamplesRoutePath(entry.id)) },
      props: { kind: "example-entry", entry }
    })),
    {
      params: { page: routeToParam(apiRootForPaths) },
      props: { kind: "api-index" }
    },
    ...apiPackageEntriesForPaths.map((entry) => ({
      params: { page: routeToParam(getApiPackageRoute(entry)) },
      props: { kind: "api-package-entry", entry }
    })),
    ...apiEntriesForPaths.map((entry) => ({
      params: { page: routeToParam(getApiEntryRoute(entry)) },
      props: {
        kind: entry.data.kind === ReflectionKind.Class || entry.data.kind === ReflectionKind.Interface
          ? "api-class-entry"
          : entry.data.kind === ReflectionKind.Enum
            ? "api-enum-entry"
          : "api-entry",
        entry
      }
    }))
  ];
}

const props = Astro.props as StaticProps;
const { kind } = props;
const guideEntry = kind === "guide-index" || kind === "guide-entry" ? (props.entry as GuideCollectionEntry) : null;
const exampleEntry = kind === "example-entry" ? (props.entry as ExampleCollectionEntry) : null;
const apiEntry = kind === "api-entry" ? (props.entry as ApiCollectionEntry) : null;
const apiPackageEntry = kind === "api-package-entry" ? (props.entry as ApiPackageCollectionEntry) : null;
const apiClassEntry = kind === "api-class-entry" ? (props.entry as ApiCollectionEntry) : null;
const apiEnumEntry = kind === "api-enum-entry" ? (props.entry as ApiCollectionEntry) : null;

const examples = (await getCollection("examples")) as ExampleCollectionEntry[];
const exampleTree = createExampleTree(examples);

---

{guideEntry && kind === "guide-index" ? <GuideIndex entry={guideEntry} /> : null}
{guideEntry && kind === "guide-entry" ? <GuideEntry entry={guideEntry} /> : null}
{kind === "examples-index" ? <ExamplesIndex nodes={exampleTree} /> : null}
{exampleEntry && kind === "example-entry" ? <ExampleEntry entry={exampleEntry} sampleUrl={withBase(getExamplesRoutePath(exampleEntry.id, "example.html"))} /> : null}
{kind === "api-index" ? <ApiIndex /> : null}
{apiPackageEntry && kind === "api-package-entry" ? <ApiPackageEntry entry={apiPackageEntry} /> : null}
{apiClassEntry && kind === "api-class-entry" ? <ApiClassEntry entry={apiClassEntry} /> : null}
{apiEnumEntry && kind === "api-enum-entry" ? <ApiEnumEntry entry={apiEnumEntry} /> : null}
{apiEntry && kind === "api-entry" ? <ApiEntry entry={apiEntry} /> : null}
