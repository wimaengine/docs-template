---
import SidebarNav from "@components/SidebarNav.astro";
import PageOutline from "@components/PageOutline.astro";
import { rootPackageName } from "@configs/project.js";
import type { NavTab } from "@configs/navigation";
import { withBase } from "../utils/url.js";

interface HeadingLike {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  tabs?: NavTab[];
  headings?: HeadingLike[];
  rightPanel?: "api";
}

const { title = rootPackageName, tabs = [], headings = [], rightPanel } = Astro.props as Props;
const hasPageOutline = headings.some((heading) => heading.depth > 1);
const hasApiPanel = rightPanel === "api";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      .markdown-alert {
        padding: 1rem 1.2rem;
        margin: 1.25rem 0;
        border-left: 4px solid;
        border-radius: 0;
        background: var(--surface-2);
        color: var(--text);
        font-size: 0.95rem;
        line-height: 1.6;
      }

      .markdown-alert-title {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.5rem;
        font-weight: 1000;
        letter-spacing: 0.05em;
        text-transform: uppercase;

        padding: 0.25rem 0.6rem;
        border-radius: 0;
      }

      .markdown-alert p {
        margin: 0.5rem 0 0;
      }

      .markdown-alert strong {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 600;
      }
      /* NOTE */
      .markdown-alert-note {
        border-left-color: #60a5fa;
      }

      /* TIP */
      .markdown-alert-tip {
        border-left-color: #34d399;
      }

      /* IMPORTANT */
      .markdown-alert-important {
        border-left-color: #c084fc;
      }

      /* WARNING */
      .markdown-alert-warning {
        border-left-color: #fbbf24;
      }

      /* CAUTION */
      .markdown-alert-caution {
        border-left-color: #f87171;
      }
    </style>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #05070a;
        --panel: #0b1118;
        --surface-2: #101721;
        --surface-3: #151d28;
        --text: #eef2f7;
        --muted: #a8b1bd;
        --border: #243043;
        --border-strong: #314055;
        --accent: #7dd3fc;
        --accent-secondary: #cbeafe;
        --code-bg: #090d13;
        --code-text: #f3f4f6;
        --site-header-height: 3.75rem;
        --site-sidebar-width: 260px;
        --page-outline-width: 230px;
        --api-sidebar-width: 17.5rem;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        color: var(--text);
        background: var(--bg);
        overflow: hidden;
      }

      .shell {
        height: 100vh;
        overflow: hidden;
      }

      .site-header {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        height: var(--site-header-height);
        display: flex;
        align-items: center;
        padding: 0 1rem;
        border-bottom: 1px solid var(--border);
        background: var(--panel);
        z-index: 1000;
      }

      .site-header-inner {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        width: 100%;
        height: 100%;
      }

      .site-brand {
        color: var(--text);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
      }

      .site-brand:hover {
        color: var(--accent);
      }

      .menu-toggle {
        position: relative;
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
      }

      .menu-toggle:hover {
        background: transparent;
        color: var(--accent);
      }

      .menu-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .menu-toggle span {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1.25rem;
        height: 2px;
        background: var(--text);
        border-radius: 0;
        transition: transform 160ms ease-out, opacity 160ms ease-out;
      }

      .menu-toggle span:nth-child(1) {
        transform: translate(-50%, calc(-50% - 0.4rem));
      }

      .menu-toggle span:nth-child(2) {
        transform: translate(-50%, -50%);
      }

      .menu-toggle span:nth-child(3) {
        transform: translate(-50%, calc(-50% + 0.4rem));
      }

      .menu-toggle:hover span {
        background: var(--accent);
      }

      #site-sidebar {
        position: fixed;
        top: var(--site-header-height);
        left: 0;
        height: calc(100vh - var(--site-header-height));
        width: var(--site-sidebar-width);
        padding: 1.25rem 1rem;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 0;
        box-shadow: none;
        overflow-y: auto;
        overflow-anchor: none;
        z-index: 900;
        transition: transform 180ms ease-out;
      }

      body.sidebar-collapsed #site-sidebar {
        transform: translateX(-100%);
      }

      body.sidebar-collapsed main {
        margin-left: 0;
      }

      .tabs-title {
        margin: 0 0 0.75rem;
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-secondary);
      }

      .tabs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
        width: 100%;
      }

      .tab-item {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin: 0;
        width: 100%;
      }

      .tabs {
        position: relative;
      }

      .tabs a,
      .tab-toggle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        margin: 0;
        padding: 0.65rem 0.8rem;
        border: 0;
        border-radius: 0;
        text-decoration: none;
        color: var(--text);
        background: transparent;
        box-shadow: none;
        font-size: 0.92rem;
        font-weight: 600;
      }

      .tab-label {
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .nav-badge {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        min-width: 1.25rem;
        padding: 0.12rem 0.35rem;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        background: var(--surface-2);
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1;
      }

      .nav-badge.is-c {
        border-color: rgba(244, 114, 182, 0.65);
        background: rgba(244, 114, 182, 0.14);
        color: #f9a8d4;
      }

      .nav-badge.is-e {
        border-color: rgba(252, 211, 77, 0.6);
        background: rgba(252, 211, 77, 0.12);
        color: #fcd34d;
      }

      .nav-badge.is-f {
        border-color: rgba(192, 132, 252, 0.65);
        background: rgba(192, 132, 252, 0.14);
        color: #d8b4fe;
      }

      .nav-badge.is-v {
        border-color: rgba(134, 239, 172, 0.6);
        background: rgba(134, 239, 172, 0.12);
        color: #86efac;
      }

      .nav-badge.is-i {
        border-color: rgba(34, 211, 238, 0.65);
        background: rgba(34, 211, 238, 0.14);
        color: #67e8f9;
      }

      .nav-badge.is-t {
        border-color: rgba(96, 165, 250, 0.65);
        background: rgba(96, 165, 250, 0.14);
        color: #93c5fd;
      }

      .tab-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        appearance: none;
        cursor: pointer;
        text-align: left;
        list-style: none;
      }

      .tab-toggle::-webkit-details-marker {
        display: none;
      }

      .tab-toggle .chevron {
        color: var(--muted);
      }

      .tab-group[open] > .tab-toggle .chevron {
        transform: rotate(90deg);
      }

      .tabs a:hover,
      .tab-toggle:hover {
        color: var(--accent);
        background: transparent;
      }

      .tabs a.is-active,
      .tab-toggle.is-active,
      .subtabs a.is-active {
        color: var(--accent);
        background: transparent;
      }

      .subtabs {
        list-style: none;
        margin: 0;
        padding: 0 0 0 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0;
        width: 100%;
      }

      .tabs[hidden],
      .subtabs[hidden] {
        display: none;
      }

      .subtabs a {
        font-size: 0.88rem;
        padding: 0.56rem 0.9rem;
        color: var(--muted);
        background: transparent;
      }

      .subtabs a:hover {
        color: var(--accent);
      }

      main {
        height: 100vh;
        min-height: 0;
        margin: 0 0 0 var(--site-sidebar-width);
        padding: calc(var(--site-header-height) + 2rem) 2rem 2rem;
        background: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
      }

      .shell.has-page-outline main {
        margin-right: var(--page-outline-width);
      }

      .shell.has-api-panel main {
        margin-right: var(--api-sidebar-width);
      }

      h1,
      h2,
      h3 {
        line-height: 1.25;
      }

      h1 {
        margin-top: 0;
      }

      h2 {
        margin-top: 2rem;
        padding-bottom: 0.35rem;
        color: var(--accent);
      }

      h3 {
        margin-top: 1.75rem;
        color: var(--text);
      }

      p,
      li,
      blockquote {
        color: var(--muted);
        line-height: 1.6;
      }

      ul,
      ol {
        padding-left: 1.25rem;
      }

      hr {
        display: none;
      }

      blockquote {
        margin: 1.5rem 0;
        padding: 0.95rem 1.1rem;
        border: 1px solid var(--border);
        border-left: 4px solid var(--accent);
        border-radius: 0;
        background: var(--surface-2);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        border: 1px solid var(--border);
        border-radius: 0;
        overflow: hidden;
      }

      th,
      td {
        padding: 0.75rem 0.9rem;
        vertical-align: top;
      }

      th {
        text-align: left;
        color: var(--text);
        background: var(--surface-2);
      }

      code {
        font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      }

      p code,
      li code,
      td code,
      blockquote code {
        padding: 0.12rem 0.35rem;
        border: 1px solid var(--border);
        border-radius: 0;
        background: rgba(255, 255, 255, 0.03);
        color: var(--text);
      }

      pre {
        padding: 1rem;
        border-radius: 0;
        background: var(--code-bg);
        color: var(--code-text);
        overflow-x: auto;
      }

      pre code {
        color: inherit;
      }

      .astro-code {
        background-color: var(--code-bg) !important;
        border: 1px solid var(--border);
        border-radius: 0;
      }

      a {
        color: var(--accent);
      }

      a:hover {
        color: var(--accent-secondary);
      }

      @media (max-width: 900px) {
        #site-sidebar {
          transform: translateX(-100%);
          transition: transform 180ms ease;
          box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
          border-radius: 0;
        }

        body.menu-open #site-sidebar {
          transform: translateX(0);
        }

        body.menu-open .menu-toggle span:nth-child(1) {
          transform: translate(-50%, -50%) rotate(45deg);
        }

        body.menu-open .menu-toggle span:nth-child(2) {
          opacity: 0;
        }

        body.menu-open .menu-toggle span:nth-child(3) {
          transform: translate(-50%, -50%) rotate(-45deg);
        }

        .tabs {
          flex-direction: column;
        }

        main {
          margin: 0;
          padding: calc(var(--site-header-height) + 1.05rem) 2rem 2rem;
        }
      }

      @media (min-width: 901px) {
        body:not(.sidebar-collapsed) .menu-toggle span:nth-child(1) {
          transform: translate(-50%, -50%) rotate(45deg);
        }

        body:not(.sidebar-collapsed) .menu-toggle span:nth-child(2) {
          opacity: 0;
        }

        body:not(.sidebar-collapsed) .menu-toggle span:nth-child(3) {
          transform: translate(-50%, -50%) rotate(-45deg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .menu-toggle span,
        #site-sidebar {
          transition: none;
        }
      }

      @media (max-width: 1100px) {
        .shell.has-page-outline main,
        .shell.has-api-panel main {
          margin-right: 0;
          padding-right: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <div
      class:list={[
        "shell",
        hasPageOutline && "has-page-outline",
        hasApiPanel && "has-api-panel"
      ]}
    >
      <header class="site-header">
        <div class="site-header-inner">
          <button
            class="menu-toggle"
            id="menu-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded="true"
            aria-controls="site-sidebar"
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
          <a class="site-brand" href={withBase("/")}>{rootPackageName}</a>
        </div>
      </header>
      <aside id="site-sidebar" aria-label="Sidebar navigation">
        <p class="tabs-title">Navigation</p>
        {tabs.length > 0 && <SidebarNav tabs={tabs} />}
        <slot name="sidebar" />
      </aside>
      {hasPageOutline && <PageOutline headings={headings} />}
      <main id="main-content" tabindex="-1" autofocus>
        <slot />
      </main>
      {hasApiPanel && <slot name="right-panel" />}
    </div>
    <script>
      const button = document.getElementById("menu-toggle");
      const desktopViewport = window.matchMedia("(min-width: 901px)");
      const desktopSidebarStorageKey = "site-sidebar-collapsed";

      const getStoredDesktopSidebarState = () => {
        try {
          return window.localStorage.getItem(desktopSidebarStorageKey) === "true";
        } catch {
          return false;
        }
      };

      const setStoredDesktopSidebarState = (collapsed) => {
        try {
          window.localStorage.setItem(desktopSidebarStorageKey, String(collapsed));
        } catch {
          // Ignore storage failures.
        }
      };

      const updateMenuButton = () => {
        if (!button) {
          return;
        }

        const isDesktop = desktopViewport.matches;
        const open = isDesktop
          ? !document.body.classList.contains("sidebar-collapsed")
          : document.body.classList.contains("menu-open");

        button.setAttribute("aria-expanded", open ? "true" : "false");
        button.setAttribute(
          "aria-label",
          `${isDesktop ? (open ? "Collapse" : "Expand") : (open ? "Close" : "Open")} navigation`
        );
      };

      const syncSidebarMode = () => {
        if (desktopViewport.matches) {
          document.body.classList.remove("menu-open");
          document.body.classList.toggle("sidebar-collapsed", getStoredDesktopSidebarState());
        } else {
          document.body.classList.remove("sidebar-collapsed");
          document.body.classList.remove("menu-open");
        }

        updateMenuButton();
      };

      button?.addEventListener("click", () => {
        if (desktopViewport.matches) {
          const collapsed = document.body.classList.toggle("sidebar-collapsed");
          setStoredDesktopSidebarState(collapsed);
        } else {
          document.body.classList.toggle("menu-open");
        }

        updateMenuButton();
      });

      desktopViewport.addEventListener("change", syncSidebarMode);
      syncSidebarMode();

      const persistScrollPosition = (element, storageKey) => {
        let saveFrame = 0;

        const readScrollTop = () => {
          try {
            const stored = sessionStorage.getItem(storageKey);
            return stored === null ? null : Number.parseInt(stored, 10);
          } catch {
            return null;
          }
        };

        const saveScrollTop = () => {
          try {
            sessionStorage.setItem(storageKey, String(element.scrollTop));
          } catch {
            // Ignore storage failures.
          }

          saveFrame = 0;
        };

        const scheduleSave = () => {
          if (saveFrame !== 0) {
            return;
          }

          saveFrame = window.requestAnimationFrame(saveScrollTop);
        };

        const storedScrollTop = readScrollTop();
        if (storedScrollTop !== null && Number.isFinite(storedScrollTop)) {
          element.scrollTop = storedScrollTop;
        }

        element.addEventListener("scroll", scheduleSave, { passive: true });
        window.addEventListener("pagehide", saveScrollTop);
        window.addEventListener("beforeunload", saveScrollTop);
      };

      const pathname = window.location.pathname.replace(/\/+$/, "") || "/";
      const section = pathname === "/" ? "/" : pathname.split("/")[1] || pathname;
      const siteSidebar = document.getElementById("site-sidebar");
      if (siteSidebar instanceof HTMLElement) {
        persistScrollPosition(siteSidebar, `sidebar-scroll:${section}`);
      }

      const apiSidebar = document.querySelector('[data-scroll-zone="api-reference"], [data-scroll-zone="type-index"]');
      if (apiSidebar instanceof HTMLElement) {
        persistScrollPosition(apiSidebar, "sidebar-scroll:api-reference");
      }

    </script>
  </body>
</html>
