---
import { Check, Copy, Link as LinkIcon, Settings } from "@lucide/astro";
import SidebarNav from "@components/SidebarNav.astro";
import PageOutline from "@components/PageOutline.astro";
import { rootPackageName } from "@configs/project.ts";
import type { NavTab } from "@configs/navigation";
import { getWebsiteConfig, getWebsiteThemeStyles } from "@configs/site.ts";
import { withBase } from "../utils/url.ts";

interface HeadingLike {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  tabs?: NavTab[];
  headings?: HeadingLike[];
  rightPanel?: "api";
}

const { title = rootPackageName, tabs = [], headings = [], rightPanel } = Astro.props as Props;
const hasPageOutline = headings.some((heading) => heading.depth > 1);
const hasApiPanel = rightPanel === "api";
const { theme } = getWebsiteConfig();
const themeSchemeNames = Object.keys(theme.schemes);
const supportsAutoTheme = Boolean(theme.schemes.dark && theme.schemes.light);
const themeOptions = supportsAutoTheme
  ? ["auto", ...themeSchemeNames.filter((name) => name !== "auto")]
  : themeSchemeNames;
const themeStyles = getWebsiteThemeStyles(theme);
---

<!doctype html>
<html lang="en" data-theme={theme.default}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global set:html={themeStyles}></style>
    <style is:global>
      .markdown-alert {
        padding: 1rem 1.2rem;
        margin: 1.25rem 0;
        border-left: 4px solid;
        border-radius: 0;
        background: var(--surface-2);
        color: var(--text);
        font-size: 0.95rem;
        line-height: 1.6;
      }

      .markdown-alert-title {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.5rem;
        font-weight: 1000;
        letter-spacing: 0.05em;
        text-transform: uppercase;

        padding: 0.25rem 0.6rem;
        border-radius: 0;
      }

      .markdown-alert p {
        margin: 0.5rem 0 0;
      }

      .markdown-alert strong {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 600;
      }
      /* NOTE */
      .markdown-alert-note {
        border-left-color: #60a5fa;
      }

      /* TIP */
      .markdown-alert-tip {
        border-left-color: #34d399;
      }

      /* IMPORTANT */
      .markdown-alert-important {
        border-left-color: #c084fc;
      }

      /* WARNING */
      .markdown-alert-warning {
        border-left-color: #fbbf24;
      }

      /* CAUTION */
      .markdown-alert-caution {
        border-left-color: #f87171;
      }
    </style>
    <style is:global>
      :root {
        --site-header-height: 3.75rem;
        --site-sidebar-width: 260px;
        --page-outline-width: 230px;
        --api-sidebar-width: 17.5rem;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        color: var(--text);
        background: var(--bg);
        overflow: hidden;
      }

      .shell {
        height: 100vh;
        overflow: hidden;
      }

      .site-header {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        height: var(--site-header-height);
        display: flex;
        align-items: center;
        padding: 0 1rem;
        border-bottom: 1px solid var(--border);
        background: var(--panel);
        z-index: 1000;
      }

      .site-header-inner {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        width: 100%;
        height: 100%;
      }

      .site-brand {
        color: var(--text);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
      }

      .site-brand:hover {
        color: var(--accent);
      }

      .settings {
        position: relative;
        margin-left: auto;
      }

      .settings-toggle {
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
      }

      .settings-toggle svg {
        width: 1.1rem;
        height: 1.1rem;
      }

      .settings-toggle:hover {
        background: transparent;
        color: var(--accent);
      }

      .settings-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .settings-dropdown {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        z-index: 1100;
        min-width: 12rem;
        max-width: calc(100vw - 2rem);
        padding: 0.65rem;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: var(--panel);
        box-shadow: 0 14px 30px #00000026;
      }

      .settings-dropdown[hidden] {
        display: none;
      }

      .settings-section + .settings-section {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border);
      }

      .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 2rem;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .settings-row select {
        width: 9rem;
        min-width: 0;
        padding: 0.35rem 0.5rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--surface-2);
        color: var(--text);
        font: inherit;
        cursor: pointer;
      }

      .settings-row select:hover {
        border-color: var(--border-strong);
      }

      .settings-row select:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .menu-toggle {
        position: relative;
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
      }

      .menu-toggle:hover {
        background: transparent;
        color: var(--accent);
      }

      .menu-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .menu-toggle span {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1.25rem;
        height: 2px;
        background: var(--text);
        border-radius: 0;
        transition: transform 160ms ease-out, opacity 160ms ease-out;
      }

      .menu-toggle span:nth-child(1) {
        transform: translate(-50%, calc(-50% - 0.4rem));
      }

      .menu-toggle span:nth-child(2) {
        transform: translate(-50%, -50%);
      }

      .menu-toggle span:nth-child(3) {
        transform: translate(-50%, calc(-50% + 0.4rem));
      }

      .menu-toggle:hover span {
        background: var(--accent);
      }

      #site-sidebar {
        position: fixed;
        top: var(--site-header-height);
        left: 0;
        height: calc(100vh - var(--site-header-height));
        width: var(--site-sidebar-width);
        padding: 1.25rem 1rem;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 0;
        box-shadow: none;
        overflow-y: auto;
        overflow-anchor: none;
        z-index: 900;
        transition: transform 180ms ease-out;
      }

      body.sidebar-collapsed #site-sidebar {
        transform: translateX(-100%);
      }

      body.sidebar-collapsed main {
        margin-left: 0;
      }

      .tabs-title {
        margin: 0 0 0.75rem;
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-secondary);
      }

      .tabs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
        width: 100%;
      }

      .tab-item {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin: 0;
        width: 100%;
      }

      .tabs {
        position: relative;
      }

      .tabs a,
      .tab-toggle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        margin: 0;
        padding: 0.65rem 0.8rem;
        border: 0;
        border-radius: 0;
        text-decoration: none;
        color: var(--text);
        background: transparent;
        box-shadow: none;
        font-size: 0.92rem;
        font-weight: 600;
      }

      .tab-label {
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .nav-badge {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        min-width: 1.25rem;
        padding: 0.12rem 0.35rem;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        background: var(--surface-2);
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1;
      }

      .nav-badge.is-c {
        border-color: rgba(244, 114, 182, 0.65);
        background: rgba(244, 114, 182, 0.14);
        color: #f9a8d4;
      }

      .nav-badge.is-e {
        border-color: rgba(252, 211, 77, 0.6);
        background: rgba(252, 211, 77, 0.12);
        color: #fcd34d;
      }

      .nav-badge.is-f {
        border-color: rgba(192, 132, 252, 0.65);
        background: rgba(192, 132, 252, 0.14);
        color: #d8b4fe;
      }

      .nav-badge.is-v {
        border-color: rgba(134, 239, 172, 0.6);
        background: rgba(134, 239, 172, 0.12);
        color: #86efac;
      }

      .nav-badge.is-i {
        border-color: rgba(34, 211, 238, 0.65);
        background: rgba(34, 211, 238, 0.14);
        color: #67e8f9;
      }

      .nav-badge.is-t {
        border-color: rgba(96, 165, 250, 0.65);
        background: rgba(96, 165, 250, 0.14);
        color: #93c5fd;
      }

      .tab-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        appearance: none;
        cursor: pointer;
        text-align: left;
        list-style: none;
      }

      .tab-toggle::-webkit-details-marker {
        display: none;
      }

      .tab-toggle .chevron {
        color: var(--muted);
      }

      .tab-group[open] > .tab-toggle .chevron {
        transform: rotate(90deg);
      }

      .tabs a:hover,
      .tab-toggle:hover {
        color: var(--accent);
        background: transparent;
      }

      .tabs a.is-active,
      .tab-toggle.is-active,
      .subtabs a.is-active {
        color: var(--accent);
        background: transparent;
      }

      .subtabs {
        list-style: none;
        margin: 0;
        padding: 0 0 0 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0;
        width: 100%;
      }

      .tabs[hidden],
      .subtabs[hidden] {
        display: none;
      }

      .subtabs a {
        font-size: 0.88rem;
        padding: 0.56rem 0.9rem;
        color: var(--muted);
        background: transparent;
      }

      .subtabs a:hover {
        color: var(--accent);
      }

      main {
        height: 100vh;
        min-height: 0;
        margin: 0 0 0 var(--site-sidebar-width);
        padding: calc(var(--site-header-height) + 2rem) 2rem 2rem;
        background: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
      }

      .shell.has-page-outline main {
        margin-right: var(--page-outline-width);
      }

      .shell.has-api-panel main {
        margin-right: var(--api-sidebar-width);
      }

      h1,
      h2,
      h3 {
        line-height: 1.25;
      }

      h1 {
        margin-top: 0;
      }

      h2 {
        margin-top: 2rem;
        padding-bottom: 0.35rem;
        color: var(--accent);
      }

      h3 {
        margin-top: 1.75rem;
        color: var(--text);
      }

      p,
      li,
      blockquote {
        color: var(--muted);
        line-height: 1.6;
      }

      ul,
      ol {
        padding-left: 1.25rem;
      }

      hr {
        display: none;
      }

      blockquote {
        margin: 1.5rem 0;
        padding: 0.95rem 1.1rem;
        border: 1px solid var(--border);
        border-left: 4px solid var(--accent);
        border-radius: 0;
        background: var(--surface-2);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        border: 1px solid var(--border);
        border-radius: 0;
        overflow: hidden;
      }

      th,
      td {
        padding: 0.75rem 0.9rem;
        vertical-align: top;
      }

      th {
        text-align: left;
        color: var(--text);
        background: var(--surface-2);
      }

      code {
        font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      }

      p code,
      li code,
      td code,
      blockquote code {
        padding: 0.12rem 0.35rem;
        border: 1px solid var(--border);
        border-radius: 0;
        background: rgba(255, 255, 255, 0.03);
        color: var(--text);
      }

      pre {
        padding: 1rem;
        border-radius: 0;
        background: var(--code-bg);
        color: var(--code-text);
        overflow-x: auto;
      }

      pre code {
        color: inherit;
      }

      .astro-code {
        background-color: var(--code-bg) !important;
        border: 1px solid var(--border);
        border-radius: 0;
      }

      .code-copy-target {
        position: relative;
      }

      .code-copy-button {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.78rem;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 140ms ease-out, visibility 140ms ease-out;
      }

      .code-copy-target:hover .code-copy-button,
      .code-copy-target:focus-within .code-copy-button {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .code-copy-button svg {
        width: 1rem;
        height: 1rem;
      }

      .code-copy-button:hover {
        color: var(--accent);
      }

      .code-copy-button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .code-copy-button[data-state="copied"] {
        color: var(--accent);
      }

      .code-copy-button[data-state="failed"] {
        color: #fca5a5;
      }

      .code-copy-button:disabled {
        cursor: wait;
        opacity: 0.75;
      }

      .code-copy-target,
      .code-copy-target code {
        user-select: text;
      }

      @media (hover: none) {
        .code-copy-button {
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
        }
      }

      .code-copy-status {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .copy-link-heading {
        scroll-margin-top: calc(var(--site-header-height) + 1rem);
      }

      .heading-copy-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.1rem;
        height: 1.1rem;
        padding: 0;
        margin-inline-start: 0.45em;
        color: var(--muted);
        line-height: 0;
        text-align: center;
        vertical-align: 0.08em;
        text-decoration: none;
        opacity: 0;
        visibility: hidden;
        transition: color 140ms ease-out, opacity 140ms ease-out, visibility 140ms ease-out;
      }

      .copy-link-heading:hover .heading-copy-link,
      .copy-link-heading:focus-within .heading-copy-link {
        opacity: 1;
        visibility: visible;
      }

      .heading-copy-link:hover,
      .heading-copy-link:focus-visible,
      .heading-copy-link[data-state="copied"] {
        color: var(--accent);
      }

      .heading-copy-link[data-state="failed"] {
        color: #fca5a5;
      }

      .heading-copy-link:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .heading-copy-link svg {
        width: 0.9rem;
        height: 0.9rem;
      }

      @media (hover: none) {
        .heading-copy-link {
          opacity: 1;
          visibility: visible;
        }
      }

      a {
        color: var(--accent);
      }

      a:hover {
        color: var(--accent-secondary);
      }

      @media (max-width: 900px) {
        #site-sidebar {
          transform: translateX(-100%);
          transition: transform 180ms ease;
          box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
          border-radius: 0;
        }

        body.menu-open #site-sidebar {
          transform: translateX(0);
        }

        body.menu-open .menu-toggle span:nth-child(1) {
          transform: translate(-50%, -50%) rotate(45deg);
        }

        body.menu-open .menu-toggle span:nth-child(2) {
          opacity: 0;
        }

        body.menu-open .menu-toggle span:nth-child(3) {
          transform: translate(-50%, -50%) rotate(-45deg);
        }

        .tabs {
          flex-direction: column;
        }

        main {
          margin: 0;
          padding: calc(var(--site-header-height) + 1.05rem) 2rem 2rem;
        }
      }

      @media (min-width: 901px) {
        body:not(.sidebar-collapsed) .menu-toggle span:nth-child(1) {
          transform: translate(-50%, -50%) rotate(45deg);
        }

        body:not(.sidebar-collapsed) .menu-toggle span:nth-child(2) {
          opacity: 0;
        }

        body:not(.sidebar-collapsed) .menu-toggle span:nth-child(3) {
          transform: translate(-50%, -50%) rotate(-45deg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .menu-toggle span,
        #site-sidebar,
        .code-copy-button {
          transition: none;
        }
      }

      @media (max-width: 1100px) {
        .shell.has-page-outline main,
        .shell.has-api-panel main {
          margin-right: 0;
          padding-right: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <div
      class:list={[
        "shell",
        hasPageOutline && "has-page-outline",
        hasApiPanel && "has-api-panel"
      ]}
    >
      <header class="site-header">
        <div class="site-header-inner">
          <button
            class="menu-toggle"
            id="menu-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded="true"
            aria-controls="site-sidebar"
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
          <a class="site-brand" href={withBase("/")}>{rootPackageName}</a>
          <div class="settings">
            <button
              class="settings-toggle"
              id="settings-toggle"
              type="button"
              aria-label="Open settings"
              aria-expanded="false"
              aria-controls="settings-dropdown"
            >
              <Settings size={18} aria-hidden="true" />
            </button>
            <div class="settings-dropdown" id="settings-dropdown" hidden>
              <div class="settings-section">
                <div class="settings-row">
                  <label for="site-theme">Theme</label>
                  <select id="site-theme" name="site-theme">
                    {themeOptions.map((name) => (
                      <option value={name} selected={name === theme.default}>{name}</option>
                    ))}
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>
      <aside id="site-sidebar" aria-label="Sidebar navigation">
        <p class="tabs-title">Navigation</p>
        {tabs.length > 0 && <SidebarNav tabs={tabs} />}
        <slot name="sidebar" />
      </aside>
      {hasPageOutline && <PageOutline headings={headings} />}
      <main id="main-content" tabindex="-1" autofocus>
        <slot />
      </main>
      {hasApiPanel && <slot name="right-panel" />}
    </div>
    <template id="code-copy-icon">
      <Copy size={16} aria-hidden="true" />
    </template>
    <template id="code-check-icon">
      <Check size={16} aria-hidden="true" />
    </template>
    <template id="heading-copy-link-icon">
      <LinkIcon size={16} aria-hidden="true" />
    </template>
    <template id="heading-copy-link-check-icon">
      <Check size={16} aria-hidden="true" />
    </template>
    <script>
      const button = document.getElementById("menu-toggle");
      const desktopViewport = window.matchMedia("(min-width: 901px)");
      const desktopSidebarStorageKey = "site-sidebar-collapsed";

      const getStoredDesktopSidebarState = () => {
        try {
          return window.localStorage.getItem(desktopSidebarStorageKey) === "true";
        } catch {
          return false;
        }
      };

      const setStoredDesktopSidebarState = (collapsed) => {
        try {
          window.localStorage.setItem(desktopSidebarStorageKey, String(collapsed));
        } catch {
          // Ignore storage failures.
        }
      };

      const updateMenuButton = () => {
        if (!button) {
          return;
        }

        const isDesktop = desktopViewport.matches;
        const open = isDesktop
          ? !document.body.classList.contains("sidebar-collapsed")
          : document.body.classList.contains("menu-open");

        button.setAttribute("aria-expanded", open ? "true" : "false");
        button.setAttribute(
          "aria-label",
          `${isDesktop ? (open ? "Collapse" : "Expand") : (open ? "Close" : "Open")} navigation`
        );
      };

      const syncSidebarMode = () => {
        if (desktopViewport.matches) {
          document.body.classList.remove("menu-open");
          document.body.classList.toggle("sidebar-collapsed", getStoredDesktopSidebarState());
        } else {
          document.body.classList.remove("sidebar-collapsed");
          document.body.classList.remove("menu-open");
        }

        updateMenuButton();
      };

      button?.addEventListener("click", () => {
        if (desktopViewport.matches) {
          const collapsed = document.body.classList.toggle("sidebar-collapsed");
          setStoredDesktopSidebarState(collapsed);
        } else {
          document.body.classList.toggle("menu-open");
        }

        updateMenuButton();
      });

      desktopViewport.addEventListener("change", syncSidebarMode);
      syncSidebarMode();

      const settingsToggle = document.getElementById("settings-toggle");
      const settingsDropdown = document.getElementById("settings-dropdown");
      const themeSelect = document.getElementById("site-theme");
      const themeStorageKey = "site-theme";
      const themeNames = new Set(
        themeSelect instanceof HTMLSelectElement
          ? Array.from(themeSelect.options, (option) => option.value)
          : []
      );
      const supportsAutoTheme = themeNames.has("auto") &&
        themeNames.has("dark") &&
        themeNames.has("light");
      const systemTheme = supportsAutoTheme
        ? window.matchMedia("(prefers-color-scheme: dark)")
        : null;

      const readStoredTheme = () => {
        try {
          const storedTheme = window.localStorage.getItem(themeStorageKey);
          return themeNames.has(storedTheme) ? storedTheme : null;
        } catch {
          return null;
        }
      };

      const applyTheme = (name, persist = false) => {
        if (!themeNames.has(name)) {
          return;
        }

        const resolvedTheme = name === "auto" && supportsAutoTheme
          ? systemTheme.matches ? "dark" : "light"
          : name;

        document.documentElement.dataset.theme = resolvedTheme;
        if (themeSelect instanceof HTMLSelectElement) {
          themeSelect.value = name;
        }

        if (persist) {
          try {
            window.localStorage.setItem(themeStorageKey, name);
          } catch {
            // Ignore storage failures.
          }
        }
      };

      const closeSettingsDropdown = (restoreFocus = false) => {
        if (!(settingsToggle instanceof HTMLButtonElement) ||
            !(settingsDropdown instanceof HTMLElement)) {
          return;
        }

        settingsDropdown.hidden = true;
        settingsToggle.setAttribute("aria-expanded", "false");

        if (restoreFocus) {
          settingsToggle.focus();
        }
      };

      const openSettingsDropdown = () => {
        if (!(settingsToggle instanceof HTMLButtonElement) ||
            !(settingsDropdown instanceof HTMLElement)) {
          return;
        }

        settingsDropdown.hidden = false;
        settingsToggle.setAttribute("aria-expanded", "true");
        if (themeSelect instanceof HTMLSelectElement) {
          themeSelect.focus();
        }
      };

      applyTheme(
        readStoredTheme() ??
          document.documentElement.dataset.theme ??
          (themeSelect instanceof HTMLSelectElement ? themeSelect.value : undefined)
      );

      settingsToggle?.addEventListener("click", () => {
        if (!(settingsDropdown instanceof HTMLElement)) {
          return;
        }

        if (settingsDropdown.hidden) {
          openSettingsDropdown();
        } else {
          closeSettingsDropdown(true);
        }
      });

      if (themeSelect instanceof HTMLSelectElement) {
        themeSelect.addEventListener("change", () => {
          applyTheme(themeSelect.value, true);
          closeSettingsDropdown(true);
        });
      }

      systemTheme?.addEventListener("change", () => {
        if (themeSelect instanceof HTMLSelectElement && themeSelect.value === "auto") {
          applyTheme("auto");
        }
      });

      document.addEventListener("click", (event) => {
        if (!(settingsDropdown instanceof HTMLElement) ||
            !(settingsToggle instanceof HTMLElement) ||
            !(event.target instanceof Node)) {
          return;
        }

        if (!settingsDropdown.contains(event.target) && !settingsToggle.contains(event.target)) {
          closeSettingsDropdown();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" &&
            settingsDropdown instanceof HTMLElement &&
            !settingsDropdown.hidden) {
          closeSettingsDropdown(true);
        }
      });

      const copyIconTemplate = document.getElementById("code-copy-icon");
      const checkIconTemplate = document.getElementById("code-check-icon");
      const headingCopyLinkIconTemplate = document.getElementById("heading-copy-link-icon");
      const headingCopyLinkCheckIconTemplate = document.getElementById("heading-copy-link-check-icon");

      const setButtonIcon = (button, template) => {
        if (!(template instanceof HTMLTemplateElement)) {
          return;
        }

        button.replaceChildren(template.content.cloneNode(true));
      };

      const copyText = async (value) => {
        if (navigator.clipboard && typeof navigator.clipboard.writeText === "function") {
          try {
            await navigator.clipboard.writeText(value);
            return;
          } catch {
            // Fall back to the selection-based copy below.
          }
        }

        const textarea = document.createElement("textarea");
        textarea.value = value;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.top = "0";
        textarea.style.left = "-9999px";
        document.body.append(textarea);
        textarea.select();

        try {
          if (!document.execCommand("copy")) {
            throw new Error("Copy command failed");
          }
        } finally {
          textarea.remove();
        }
      };

      const enhanceCodeBlocks = () => {
        document.querySelectorAll("main pre").forEach((pre) => {
          if (pre.dataset.copyReady === "true" || !pre.parentNode) {
            return;
          }

          pre.dataset.copyReady = "true";
          pre.classList.add("code-copy-target");

          const button = document.createElement("button");
          button.className = "code-copy-button";
          button.type = "button";
          setButtonIcon(button, copyIconTemplate);
          button.setAttribute("aria-label", "Copy code");

          const status = document.createElement("span");
          status.className = "code-copy-status";
          status.setAttribute("role", "status");
          status.setAttribute("aria-live", "polite");

          pre.append(button, status);

          let resetTimer = 0;
          button.addEventListener("click", async () => {
            const code = pre.querySelector("code");
            const value = code?.textContent ?? pre.textContent ?? "";

            button.disabled = true;
            window.clearTimeout(resetTimer);

            try {
              await copyText(value);
              button.dataset.state = "copied";
              setButtonIcon(button, checkIconTemplate);
              button.setAttribute("aria-label", "Code copied");
              status.textContent = "Code copied to clipboard.";
            } catch {
              button.dataset.state = "failed";
              setButtonIcon(button, copyIconTemplate);
              button.setAttribute("aria-label", "Copy code failed");
              status.textContent = "Copy failed. Select the code manually to copy it.";
            }

            resetTimer = window.setTimeout(() => {
              button.disabled = false;
              button.dataset.state = "";
              setButtonIcon(button, copyIconTemplate);
              button.setAttribute("aria-label", "Copy code");
              status.textContent = "";
            }, 1800);
          });
        });
      };

      const slugifyHeading = (value) => {
        const slug = value
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");

        return slug || "section";
      };

      const getUniqueHeadingId = (heading, text) => {
        const baseId = slugifyHeading(text);
        let id = baseId;
        let suffix = 2;

        while (document.getElementById(id) && document.getElementById(id) !== heading) {
          id = `${baseId}-${suffix}`;
          suffix += 1;
        }

        return id;
      };

      const getHeadingAnchorId = (heading, text) => {
        if (heading.id) {
          return heading.id;
        }

        const section = heading.matches("h2, h3")
          ? heading.closest("article.member-section, details.api-group")
          : null;
        if (section instanceof HTMLElement && section.id) {
          return section.id;
        }

        const id = getUniqueHeadingId(heading, text);
        heading.id = id;
        return id;
      };

      const enhanceHeadingLinks = () => {
        document.querySelectorAll("main h1, main h2, main h3, main h4, main h5, main h6").forEach((heading) => {
          if (!(heading instanceof HTMLElement) || heading.dataset.copyLinkReady === "true") {
            return;
          }

          const text = heading.textContent?.replace(/\s+/g, " ").trim() || "section";
          const anchorId = getHeadingAnchorId(heading, text);
          const link = document.createElement("a");
          link.className = "heading-copy-link";
          link.href = `#${anchorId}`;
          link.setAttribute("aria-label", `Copy link to ${text}`);
          link.title = "Copy link";
          setButtonIcon(link, headingCopyLinkIconTemplate);

          const status = document.createElement("span");
          status.className = "code-copy-status";
          status.setAttribute("role", "status");
          status.setAttribute("aria-live", "polite");

          heading.dataset.copyLinkReady = "true";
          heading.classList.add("copy-link-heading");
          heading.append(link, status);

          let resetTimer = 0;
          link.addEventListener("click", async (event) => {
            event.stopPropagation();

            const value = new URL(link.href, window.location.href).toString();
            window.clearTimeout(resetTimer);

            try {
              await copyText(value);
              link.dataset.state = "copied";
              setButtonIcon(link, headingCopyLinkCheckIconTemplate);
              link.setAttribute("aria-label", "Link copied");
              status.textContent = "Link copied to clipboard.";
            } catch {
              link.dataset.state = "failed";
              link.setAttribute("aria-label", "Copy link failed");
              status.textContent = "Copy failed.";
            }

            resetTimer = window.setTimeout(() => {
              link.dataset.state = "";
              setButtonIcon(link, headingCopyLinkIconTemplate);
              link.setAttribute("aria-label", `Copy link to ${text}`);
              status.textContent = "";
            }, 1800);
          });
        });
      };

      enhanceCodeBlocks();
      enhanceHeadingLinks();
      document.addEventListener("astro:page-load", enhanceCodeBlocks);
      document.addEventListener("astro:page-load", enhanceHeadingLinks);

      const persistScrollPosition = (element, storageKey) => {
        let saveFrame = 0;

        const readScrollTop = () => {
          try {
            const stored = sessionStorage.getItem(storageKey);
            return stored === null ? null : Number.parseInt(stored, 10);
          } catch {
            return null;
          }
        };

        const saveScrollTop = () => {
          try {
            sessionStorage.setItem(storageKey, String(element.scrollTop));
          } catch {
            // Ignore storage failures.
          }

          saveFrame = 0;
        };

        const scheduleSave = () => {
          if (saveFrame !== 0) {
            return;
          }

          saveFrame = window.requestAnimationFrame(saveScrollTop);
        };

        const storedScrollTop = readScrollTop();
        if (storedScrollTop !== null && Number.isFinite(storedScrollTop)) {
          element.scrollTop = storedScrollTop;
        }

        element.addEventListener("scroll", scheduleSave, { passive: true });
        window.addEventListener("pagehide", saveScrollTop);
        window.addEventListener("beforeunload", saveScrollTop);
      };

      const pathname = window.location.pathname.replace(/\/+$/, "") || "/";
      const section = pathname === "/" ? "/" : pathname.split("/")[1] || pathname;
      const siteSidebar = document.getElementById("site-sidebar");
      if (siteSidebar instanceof HTMLElement) {
        persistScrollPosition(siteSidebar, `sidebar-scroll:${section}`);
      }

      const apiSidebar = document.querySelector('[data-scroll-zone="api-reference"], [data-scroll-zone="type-index"]');
      if (apiSidebar instanceof HTMLElement) {
        persistScrollPosition(apiSidebar, "sidebar-scroll:api-reference");
      }

    </script>
  </body>
</html>
