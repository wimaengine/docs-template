---
import { withBase } from "../utils/url.ts";
import { buildImportMap } from "../utils/import-map.ts";
import { getWebsiteConfig, getWebsiteThemeStyles } from "../config/site.ts";
import Seo from "../components/Seo.astro";

interface Props {
  source: string;
  title?: string;
  description?: string;
}

const { source, title = "Example", description } = Astro.props;
const isProd = import.meta.env.PROD;

const importMap = buildImportMap(isProd);
const { theme, seo } = getWebsiteConfig();
const themeStyles = getWebsiteThemeStyles(theme);

const rewriteAssetLiterals = (script: string): string =>
  script.replace(
    /(["'`])\/?assets\/([^"'`]+)\1/g,
    (_, _quote: string, rest: string) => {
      return "`" + withBase(`/${rest}`) + "`";
    },
  );
const runnerScript = isProd ? rewriteAssetLiterals(source) : source;
---

<!doctype html>
<html lang={seo.locale} data-theme={theme.default}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} noindex />
    <style is:global set:html={themeStyles}></style>
    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        background: var(--bg);
        color: var(--text);
        overflow: hidden;
      }

      canvas {
        display: block;
        width: 100%;
        height: 100%;
        background-color: black;
        touch-action: none;
      }
      .dg.ac {
        position: fixed;
        top: 0;
        left: auto;
        right: 0;
        z-index: 10000;
      }
      .performance-monitor {
        position: fixed;
        top: 0%;
        left: 0%;
        right: auto;
        cursor: pointer;
        opacity: 0.9;
        z-index: 10000;
      }
    </style>
    <script type="importmap" set:html={importMap} />
  </head>
  <body>
    <script type="module" set:html={runnerScript} />
  </body>
</html>
