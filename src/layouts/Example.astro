---
import { withBase } from "../utils/url.js";
import { buildImportMap } from "../utils/import-map.js";

interface Props {
  source: string;
  title?: string;
}

const { source, title = "Example" } = Astro.props;
const isProd = import.meta.env.PROD;

const importMap = buildImportMap(isProd);

const rewriteAssetLiterals = (script: string): string =>
  script.replace(
    /(["'`])\/?assets\/([^"'`]+)\1/g,
    (_, _quote: string, rest: string) => {
      return "`" + withBase(`/${rest}`) + "`";
    },
  );
const runnerScript = isProd ? rewriteAssetLiterals(source) : source;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #05070a;
      }

      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        background: var(--bg);
        color: #eef2f7;
        overflow: hidden;
      }

      canvas {
        background-color: black;
        touch-action: none;
      }
      .dg.ac {
        position: fixed;
        top: 0;
        left: auto;
        right: 0;
        z-index: 10000;
      }
      .performance-monitor {
        position: fixed;
        top: 0%;
        left: 0%;
        right: auto;
        cursor: pointer;
        opacity: 0.9;
        z-index: 10000;
      }
    </style>
    <script type="importmap" set:html={importMap} />
  </head>
  <body>
    <script type="module" set:html={runnerScript} />
  </body>
</html>
