{
  "name": "wima-docs-website-template",
  "version": "0.5.0",
  "description": "Astro integration package for the wima docs website template.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./loaders": "./src/loaders.ts",
    "./content.config": "./src/content.config.ts",
    "./routes/*": "./src/pages/*",
    "./config": "./src/config/index.ts",
    "./config/*": "./src/config/*",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./screens/*": "./src/screens/*",
    "./utils/*": "./src/utils/*",
    "./plugins/*": "./src/plugins/*"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "astro": "^7.2.2",
    "typescript": ">=5.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.5",
    "@lucide/astro": "^1.71.0",
    "flexsearch": "^0.7.43",
    "resolve.exports": "^2.0.3",
    "typedoc": "^0.28.20"
  },
  "devDependencies": {
    "astro": "^7.2.2"
  },
  "license": "MIT",
  "author": "Wayne Mwashuma",
  "homepage": "https://github.com/wimaengine/docs-template#readme",
  "bugs": {
    "url": "https://github.com/wimaengine/docs-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wimaengine/docs-template.git"
  }
}
