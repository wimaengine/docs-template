{
  "name": "wima-docs-website-template",
  "version": "0.1.0",
  "description": "Astro integration package for the wima docs website template.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./loaders": "./src/loaders.js",
    "./content.config": "./src/content.config.js",
    "./routes/*": "./src/pages/*",
    "./config": "./src/config/index.js",
    "./config/*": "./src/config/*",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./screens/*": "./src/screens/*",
    "./utils/*": "./src/utils/*",
    "./plugins/*": "./src/plugins/*"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "astro": "^7.2.2"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.5",
    "resolve.exports": "^2.0.3"
  },
  "devDependencies": {
    "astro": "^7.2.2"
  },
